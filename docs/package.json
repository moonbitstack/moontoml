{
  "name": "moontoml-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "stylus src/site.styl -o assets/site.css --compress",
    "js": "esbuild src/app.tsx --bundle --minify --format=esm --jsx=automatic --target=es2020 --outfile=assets/app.js",
    "build": "npm run css && npm run js"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stylus": "0.64.0"
  }
}
