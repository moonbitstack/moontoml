// TOML 1.0.0, https://toml.io/en/v1.0.0 — read and written as a `Json` tree.
//
// TOML defines one document, not a stream, so there is no plural form of the
// four entry points. Dates and 64-bit integers are where the tree is narrower
// than the format; the README says exactly how.
import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/double",
  "moonbitstack/moondate",
}
