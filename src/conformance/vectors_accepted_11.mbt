      want: "{\n    \"ldt1\": {\"type\": \"datetime-local\", \"value\": \"1979-05-27T07:32:00\"},\n    \"ldt2\": {\"type\": \"datetime-local\", \"value\": \"1979-05-27T07:32:00.5\"},\n    \"ldt3\": {\"type\": \"datetime-local\", \"value\": \"1979-05-27T00:32:00.999\"}\n}\n",
