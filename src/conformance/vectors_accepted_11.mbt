      src: b"integers = [ 1, 2, 3 ]\x0acolors = [ \"red\", \"yellow\", \"green\" ]\x0anested_arrays_of_ints = [ [ 1, 2 ], [3, 4, 5] ]\x0anested_mixed_array = [ [ 1, 2 ], [\"a\", \"b\", \"c\"] ]\x0astring_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''' ]\x0a\x0a# Mixed-type arrays are allowed\x0anumbers = [ 0.1, 0.2, 0.5, 1, 2, 5 ]\x0acontributors = [\x0a  \"Foo Bar <foo@example.com>\",\x0a  { name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" }\x0a]\x0a",
      want: "{\n    \"colors\": [\n        {\"type\": \"string\", \"value\": \"red\"},\n        {\"type\": \"string\", \"value\": \"yellow\"},\n        {\"type\": \"string\", \"value\": \"green\"}\n    ],\n    \"contributors\": [\n        {\"type\": \"string\", \"value\": \"Foo Bar \\u003cfoo@example.com\\u003e\"},\n        {\n            \"email\": {\"type\": \"string\", \"value\": \"bazqux@example.com\"},\n            \"name\":  {\"type\": \"string\", \"value\": \"Baz Qux\"},\n            \"url\":   {\"type\": \"string\", \"value\": \"https://example.com/bazqux\"}\n        }\n    ],\n    \"integers\": [\n        {\"type\": \"integer\", \"value\": \"1\"},\n        {\"type\": \"integer\", \"value\": \"2\"},\n        {\"type\": \"integer\", \"value\": \"3\"}\n    ],\n    \"nested_arrays_of_ints\": [\n        [\n            {\"type\": \"integer\", \"value\": \"1\"},\n            {\"type\": \"integer\", \"value\": \"2\"}\n        ],\n        [\n            {\"type\": \"integer\", \"value\": \"3\"},\n            {\"type\": \"integer\", \"value\": \"4\"},\n            {\"type\": \"integer\", \"value\": \"5\"}\n        ]\n    ],\n    \"nested_mixed_array\": [\n        [\n            {\"type\": \"integer\", \"value\": \"1\"},\n            {\"type\": \"integer\", \"value\": \"2\"}\n        ],\n        [\n            {\"type\": \"string\", \"value\": \"a\"},\n            {\"type\": \"string\", \"value\": \"b\"},\n            {\"type\": \"string\", \"value\": \"c\"}\n        ]\n    ],\n    \"numbers\": [\n        {\"type\": \"float\", \"value\": \"0.1\"},\n        {\"type\": \"float\", \"value\": \"0.2\"},\n        {\"type\": \"float\", \"value\": \"0.5\"},\n        {\"type\": \"integer\", \"value\": \"1\"},\n        {\"type\": \"integer\", \"value\": \"2\"},\n        {\"type\": \"integer\", \"value\": \"5\"}\n    ],\n    \"string_array\": [\n        {\"type\": \"string\", \"value\": \"all\"},\n        {\"type\": \"string\", \"value\": \"strings\"},\n        {\"type\": \"string\", \"value\": \"are the same\"},\n        {\"type\": \"string\", \"value\": \"type\"}\n    ]\n}\n",
    },
  ]
}

///|
fn accepted_11_07() -> Array[Accepted] {
  [
    {
      name: "valid/spec-1.1.0/common-36.toml",
      src: b"integers2 = [\x0a  1, 2, 3\x0a]\x0a\x0aintegers3 = [\x0a  1,\x0a  2, # this is ok\x0a]\x0a",
      want: "{\n    \"integers2\": [\n        {\"type\": \"integer\", \"value\": \"1\"},\n        {\"type\": \"integer\", \"value\": \"2\"},\n        {\"type\": \"integer\", \"value\": \"3\"}\n    ],\n    \"integers3\": [\n        {\"type\": \"integer\", \"value\": \"1\"},\n        {\"type\": \"integer\", \"value\": \"2\"}\n    ]\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-37.toml",
      src: b"[table]\x0a",
      want: "{\n    \"table\": {}\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-38.toml",
      src: b"[table-1]\x0akey1 = \"some string\"\x0akey2 = 123\x0a\x0a[table-2]\x0akey1 = \"another string\"\x0akey2 = 456\x0a",
      want: "{\n    \"table-1\": {\n        \"key1\": {\"type\": \"string\", \"value\": \"some string\"},\n        \"key2\": {\"type\": \"integer\", \"value\": \"123\"}\n    },\n    \"table-2\": {\n        \"key1\": {\"type\": \"string\", \"value\": \"another string\"},\n        \"key2\": {\"type\": \"integer\", \"value\": \"456\"}\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-39.toml",
      src: b"[dog.\"tater.man\"]\x0atype.name = \"pug\"\x0a",
      want: "{\n    \"dog\": {\n        \"tater.man\": {\n            \"type\": {\n                \"name\": {\"type\": \"string\", \"value\": \"pug\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-4.toml",
      src: b"\"127.0.0.1\" = \"value\"\x0a\"character encoding\" = \"value\"\x0a\"\xca\x8e\xc7\x9d\xca\x9e\" = \"value\"\x0a'key2' = \"value\"\x0a'quoted \"value\"' = \"value\"\x0a",
      want: "{\n    \"127.0.0.1\":          {\"type\": \"string\", \"value\": \"value\"},\n    \"character encoding\": {\"type\": \"string\", \"value\": \"value\"},\n    \"key2\":               {\"type\": \"string\", \"value\": \"value\"},\n    \"quoted \\\"value\\\"\":   {\"type\": \"string\", \"value\": \"value\"},\n    \"\u{28e}\u{1dd}\u{29e}\":                {\"type\": \"string\", \"value\": \"value\"}\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-40.toml",
      src: b"[a.b.c]            # this is best practice\x0a[ d.e.f ]          # same as [d.e.f]\x0a[ g .  h  . i ]    # same as [g.h.i]\x0a[ j . \"\xca\x9e\" . 'l' ]  # same as [j.\"\xca\x9e\".'l']\x0a",
      want: "{\n    \"a\": {\n        \"b\": {\n            \"c\": {}\n        }\n    },\n    \"d\": {\n        \"e\": {\n            \"f\": {}\n        }\n    },\n    \"g\": {\n        \"h\": {\n            \"i\": {}\n        }\n    },\n    \"j\": {\n        \"\u{29e}\": {\n            \"l\": {}\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-41.toml",
      src: b"# [x] you\x0a# [x.y] don't\x0a# [x.y.z] need these\x0a[x.y.z.w] # for this to work\x0a\x0a[x] # defining a super-table afterward is ok\x0a",
      want: "{\n    \"x\": {\n        \"y\": {\n            \"z\": {\n                \"w\": {}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-42.toml",
      src: b"# VALID BUT DISCOURAGED\x0a[fruit.apple]\x0a[animal]\x0a[fruit.orange]\x0a",
      want: "{\n    \"animal\": {},\n    \"fruit\": {\n        \"apple\":  {},\n        \"orange\": {}\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-43.toml",
      src: b"# RECOMMENDED\x0a[fruit.apple]\x0a[fruit.orange]\x0a[animal]\x0a",
      want: "{\n    \"animal\": {},\n    \"fruit\": {\n        \"apple\":  {},\n        \"orange\": {}\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-44.toml",
      src: b"# Top-level table begins.\x0aname = \"Fido\"\x0abreed = \"pug\"\x0a\x0a# Top-level table ends.\x0a[owner]\x0aname = \"Regina Dogman\"\x0amember_since = 1999-08-04\x0a",
      want: "{\n    \"breed\": {\"type\": \"string\", \"value\": \"pug\"},\n    \"name\":  {\"type\": \"string\", \"value\": \"Fido\"},\n    \"owner\": {\n        \"member_since\": {\"type\": \"date-local\", \"value\": \"1999-08-04\"},\n        \"name\":         {\"type\": \"string\", \"value\": \"Regina Dogman\"}\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-45.toml",
      src: b"fruit.apple.color = \"red\"\x0a# Defines a table named fruit\x0a# Defines a table named fruit.apple\x0a\x0afruit.apple.taste.sweet = true\x0a# Defines a table named fruit.apple.taste\x0a# fruit and fruit.apple were already created\x0a",
      want: "{\n    \"fruit\": {\n        \"apple\": {\n            \"color\": {\"type\": \"string\", \"value\": \"red\"},\n            \"taste\": {\n                \"sweet\": {\"type\": \"bool\", \"value\": \"true\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-46.toml",
      src: b"[fruit]\x0aapple.color = \"red\"\x0aapple.taste.sweet = true\x0a\x0a# [fruit.apple]  # INVALID\x0a# [fruit.apple.taste]  # INVALID\x0a\x0a[fruit.apple.texture]  # you can add sub-tables\x0asmooth = true\x0a",
      want: "{\n    \"fruit\": {\n        \"apple\": {\n            \"color\": {\"type\": \"string\", \"value\": \"red\"},\n            \"taste\": {\n                \"sweet\": {\"type\": \"bool\", \"value\": \"true\"}\n            },\n            \"texture\": {\n                \"smooth\": {\"type\": \"bool\", \"value\": \"true\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-47.toml",
      src: b"name = { first = \"Tom\", last = \"Preston-Werner\" }\x0apoint = {x=1, y=2}\x0aanimal = { type.name = \"pug\" }\x0acontact = {\x0a    personal = {\x0a        name = \"Donald Duck\",\x0a        email = \"donald@duckburg.com\",\x0a    },\x0a    work = {\x0a        name = \"Coin cleaner\",\x0a        email = \"donald@ScroogeCorp.com\",\x0a    },\x0a}\x0a",
      want: "{\n    \"animal\": {\n        \"type\": {\n            \"name\": {\"type\": \"string\", \"value\": \"pug\"}\n        }\n    },\n    \"contact\": {\n        \"personal\": {\n            \"email\": {\"type\": \"string\", \"value\": \"donald@duckburg.com\"},\n            \"name\":  {\"type\": \"string\", \"value\": \"Donald Duck\"}\n        },\n        \"work\": {\n            \"email\": {\"type\": \"string\", \"value\": \"donald@ScroogeCorp.com\"},\n            \"name\":  {\"type\": \"string\", \"value\": \"Coin cleaner\"}\n        }\n    },\n    \"name\": {\n        \"first\": {\"type\": \"string\", \"value\": \"Tom\"},\n        \"last\":  {\"type\": \"string\", \"value\": \"Preston-Werner\"}\n    },\n    \"point\": {\n        \"x\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"y\": {\"type\": \"integer\", \"value\": \"2\"}\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-48.toml",
      src: b"[name]\x0afirst = \"Tom\"\x0alast = \"Preston-Werner\"\x0a\x0a[point]\x0ax = 1\x0ay = 2\x0a\x0a[animal]\x0atype.name = \"pug\"\x0a\x0a[contact.personal]\x0aname = \"Donald Duck\"\x0aemail = \"donald@duckburg.com\"\x0a\x0a[contact.work]\x0aname = \"Coin cleaner\"\x0aemail = \"donald@ScroogeCorp.com\"\x0a",
      want: "{\n    \"animal\": {\n        \"type\": {\n            \"name\": {\"type\": \"string\", \"value\": \"pug\"}\n        }\n    },\n    \"contact\": {\n        \"personal\": {\n            \"email\": {\"type\": \"string\", \"value\": \"donald@duckburg.com\"},\n            \"name\":  {\"type\": \"string\", \"value\": \"Donald Duck\"}\n        },\n        \"work\": {\n            \"email\": {\"type\": \"string\", \"value\": \"donald@ScroogeCorp.com\"},\n            \"name\":  {\"type\": \"string\", \"value\": \"Coin cleaner\"}\n        }\n    },\n    \"name\": {\n        \"first\": {\"type\": \"string\", \"value\": \"Tom\"},\n        \"last\":  {\"type\": \"string\", \"value\": \"Preston-Werner\"}\n    },\n    \"point\": {\n        \"x\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"y\": {\"type\": \"integer\", \"value\": \"2\"}\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-49.toml",
      src: b"[product]\x0atype = { name = \"Nail\" }\x0a# type.edible = false  # INVALID\x0a",
      want: "{\n    \"product\": {\n        \"type\": {\n            \"name\": {\"type\": \"string\", \"value\": \"Nail\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-50.toml",
      src: b"[product]\x0atype.name = \"Nail\"\x0a# type = { edible = false }  # INVALID\x0a",
      want: "{\n    \"product\": {\n        \"type\": {\n            \"name\": {\"type\": \"string\", \"value\": \"Nail\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-51.toml",
      src: b"[[product]]\x0aname = \"Hammer\"\x0asku = 738594937\x0a\x0a[[product]]  # empty table within the array\x0a\x0a[[product]]\x0aname = \"Nail\"\x0asku = 284758393\x0a\x0acolor = \"gray\"\x0a",
      want: "{\n    \"product\": [\n        {\n            \"name\": {\"type\": \"string\", \"value\": \"Hammer\"},\n            \"sku\":  {\"type\": \"integer\", \"value\": \"738594937\"}\n        },\n        {},\n        {\n            \"color\": {\"type\": \"string\", \"value\": \"gray\"},\n            \"name\":  {\"type\": \"string\", \"value\": \"Nail\"},\n            \"sku\":   {\"type\": \"integer\", \"value\": \"284758393\"}\n        }\n    ]\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-52.toml",
      src: b"[[fruits]]\x0aname = \"apple\"\x0a\x0a[fruits.physical]  # subtable\x0acolor = \"red\"\x0ashape = \"round\"\x0a\x0a[[fruits.varieties]]  # nested array of tables\x0aname = \"red delicious\"\x0a\x0a[[fruits.varieties]]\x0aname = \"granny smith\"\x0a\x0a\x0a[[fruits]]\x0aname = \"banana\"\x0a\x0a[[fruits.varieties]]\x0aname = \"plantain\"\x0a",
      want: "{\n    \"fruits\": [\n        {\n            \"name\": {\"type\": \"string\", \"value\": \"apple\"},\n            \"physical\": {\n                \"color\": {\"type\": \"string\", \"value\": \"red\"},\n                \"shape\": {\"type\": \"string\", \"value\": \"round\"}\n            },\n            \"varieties\": [\n                {\n                    \"name\": {\"type\": \"string\", \"value\": \"red delicious\"}\n                },\n                {\n                    \"name\": {\"type\": \"string\", \"value\": \"granny smith\"}\n                }\n            ]\n        },\n        {\n            \"name\":      {\"type\": \"string\", \"value\": \"banana\"},\n            \"varieties\": [{\n                \"name\": {\"type\": \"string\", \"value\": \"plantain\"}\n            }]\n        }\n    ]\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-53.toml",
      src: b"points = [ { x = 1, y = 2, z = 3 },\x0a           { x = 7, y = 8, z = 9 },\x0a           { x = 2, y = 4, z = 8 } ]\x0a",
      want: "{\n    \"points\": [\n        {\n            \"x\": {\"type\": \"integer\", \"value\": \"1\"},\n            \"y\": {\"type\": \"integer\", \"value\": \"2\"},\n            \"z\": {\"type\": \"integer\", \"value\": \"3\"}\n        },\n        {\n            \"x\": {\"type\": \"integer\", \"value\": \"7\"},\n            \"y\": {\"type\": \"integer\", \"value\": \"8\"},\n            \"z\": {\"type\": \"integer\", \"value\": \"9\"}\n        },\n        {\n            \"x\": {\"type\": \"integer\", \"value\": \"2\"},\n            \"y\": {\"type\": \"integer\", \"value\": \"4\"},\n            \"z\": {\"type\": \"integer\", \"value\": \"8\"}\n        }\n    ]\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-6.toml",
      src: b"name = \"Orange\"\x0aphysical.color = \"orange\"\x0aphysical.shape = \"round\"\x0asite.\"google.com\" = true\x0a",
      want: "{\n    \"name\": {\"type\": \"string\", \"value\": \"Orange\"},\n    \"physical\": {\n        \"color\": {\"type\": \"string\", \"value\": \"orange\"},\n        \"shape\": {\"type\": \"string\", \"value\": \"round\"}\n    },\n    \"site\": {\n        \"google.com\": {\"type\": \"bool\", \"value\": \"true\"}\n    }\n}\n",
    },
  ]
}

///|
fn accepted_11_08() -> Array[Accepted] {
  [
    {
      name: "valid/spec-1.1.0/common-7.toml",
      src: b"fruit.name = \"banana\"       # this is best practice\x0afruit. color = \"yellow\"     # same as fruit.color\x0afruit . flavor = \"banana\"   # same as fruit.flavor\x0a",
      want: "{\n    \"fruit\": {\n        \"color\":  {\"type\": \"string\", \"value\": \"yellow\"},\n        \"flavor\": {\"type\": \"string\", \"value\": \"banana\"},\n        \"name\":   {\"type\": \"string\", \"value\": \"banana\"}\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-8.toml",
      src: b"# This makes the key \"fruit\" into a table.\x0afruit.apple.smooth = true\x0a\x0a# So then you can add to the table \"fruit\" like so:\x0afruit.orange = 2\x0a",
      want: "{\n    \"fruit\": {\n        \"orange\": {\"type\": \"integer\", \"value\": \"2\"},\n        \"apple\": {\n            \"smooth\": {\"type\": \"bool\", \"value\": \"true\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-1.1.0/common-9.toml",
      src: b"# VALID BUT DISCOURAGED\x0a\x0aapple.type = \"fruit\"\x0aorange.type = \"fruit\"\x0a\x0aapple.skin = \"thin\"\x0aorange.skin = \"thick\"\x0a\x0aapple.color = \"red\"\x0aorange.color = \"orange\"\x0a",
      want: "{\n    \"apple\": {\n        \"color\": {\"type\": \"string\", \"value\": \"red\"},\n        \"skin\":  {\"type\": \"string\", \"value\": \"thin\"},\n        \"type\":  {\"type\": \"string\", \"value\": \"fruit\"}\n    },\n    \"orange\": {\n        \"color\": {\"type\": \"string\", \"value\": \"orange\"},\n        \"skin\":  {\"type\": \"string\", \"value\": \"thick\"},\n        \"type\":  {\"type\": \"string\", \"value\": \"fruit\"}\n    }\n}\n",
    },
    {
      name: "valid/spec-example-1-compact.toml",
      src: b"#Useless spaces eliminated.\x0atitle=\"TOML Example\"\x0a[owner]\x0aname=\"Lance Uppercut\"\x0adob=1979-05-27T07:32:00-08:00#First class dates\x0a[database]\x0aserver=\"192.168.1.1\"\x0aports=[8001,8001,8002]\x0aconnection_max=5000\x0aenabled=true\x0a[servers]\x0a[servers.alpha]\x0aip=\"10.0.0.1\"\x0adc=\"eqdc10\"\x0a[servers.beta]\x0aip=\"10.0.0.2\"\x0adc=\"eqdc10\"\x0a[clients]\x0adata=[[\"gamma\",\"delta\"],[1,2]]\x0ahosts=[\x0a\"alpha\",\x0a\"omega\"\x0a]\x0a",
      want: "{\n    \"title\": {\"type\": \"string\", \"value\": \"TOML Example\"},\n    \"clients\": {\n        \"data\": [\n            [\n                {\"type\": \"string\", \"value\": \"gamma\"},\n                {\"type\": \"string\", \"value\": \"delta\"}\n            ],\n            [\n                {\"type\": \"integer\", \"value\": \"1\"},\n                {\"type\": \"integer\", \"value\": \"2\"}\n            ]\n        ],\n        \"hosts\": [\n            {\"type\": \"string\", \"value\": \"alpha\"},\n            {\"type\": \"string\", \"value\": \"omega\"}\n        ]\n    },\n    \"database\": {\n        \"connection_max\": {\"type\": \"integer\", \"value\": \"5000\"},\n        \"enabled\":        {\"type\": \"bool\", \"value\": \"true\"},\n        \"server\":         {\"type\": \"string\", \"value\": \"192.168.1.1\"},\n        \"ports\": [\n            {\"type\": \"integer\", \"value\": \"8001\"},\n            {\"type\": \"integer\", \"value\": \"8001\"},\n            {\"type\": \"integer\", \"value\": \"8002\"}\n        ]\n    },\n    \"owner\": {\n        \"dob\":  {\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00-08:00\"},\n        \"name\": {\"type\": \"string\", \"value\": \"Lance Uppercut\"}\n    },\n    \"servers\": {\n        \"alpha\": {\n            \"dc\": {\"type\": \"string\", \"value\": \"eqdc10\"},\n            \"ip\": {\"type\": \"string\", \"value\": \"10.0.0.1\"}\n        },\n        \"beta\": {\n            \"dc\": {\"type\": \"string\", \"value\": \"eqdc10\"},\n            \"ip\": {\"type\": \"string\", \"value\": \"10.0.0.2\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/spec-example-1.toml",
      src: b"# This is a TOML document. Boom.\x0a\x0atitle = \"TOML Example\"\x0a\x0a[owner]\x0aname = \"Lance Uppercut\"\x0adob = 1979-05-27T07:32:00-08:00 # First class dates? Why not?\x0a\x0a[database]\x0aserver = \"192.168.1.1\"\x0aports = [ 8001, 8001, 8002 ]\x0aconnection_max = 5000\x0aenabled = true\x0a\x0a[servers]\x0a\x0a  # You can indent as you please. Tabs or spaces. TOML don't care.\x0a  [servers.alpha]\x0a  ip = \"10.0.0.1\"\x0a  dc = \"eqdc10\"\x0a\x0a  [servers.beta]\x0a  ip = \"10.0.0.2\"\x0a  dc = \"eqdc10\"\x0a\x0a[clients]\x0adata = [ [\"gamma\", \"delta\"], [1, 2] ]\x0a\x0a# Line breaks are OK when inside arrays\x0ahosts = [\x0a  \"alpha\",\x0a  \"omega\"\x0a]\x0a",
      want: "{\n    \"title\": {\"type\": \"string\", \"value\": \"TOML Example\"},\n    \"clients\": {\n        \"data\": [\n            [\n                {\"type\": \"string\", \"value\": \"gamma\"},\n                {\"type\": \"string\", \"value\": \"delta\"}\n            ],\n            [\n                {\"type\": \"integer\", \"value\": \"1\"},\n                {\"type\": \"integer\", \"value\": \"2\"}\n            ]\n        ],\n        \"hosts\": [\n            {\"type\": \"string\", \"value\": \"alpha\"},\n            {\"type\": \"string\", \"value\": \"omega\"}\n        ]\n    },\n    \"database\": {\n        \"connection_max\": {\"type\": \"integer\", \"value\": \"5000\"},\n        \"enabled\":        {\"type\": \"bool\", \"value\": \"true\"},\n        \"server\":         {\"type\": \"string\", \"value\": \"192.168.1.1\"},\n        \"ports\": [\n            {\"type\": \"integer\", \"value\": \"8001\"},\n            {\"type\": \"integer\", \"value\": \"8001\"},\n            {\"type\": \"integer\", \"value\": \"8002\"}\n        ]\n    },\n    \"owner\": {\n        \"dob\":  {\"type\": \"datetime\", \"value\": \"1979-05-27T07:32:00-08:00\"},\n        \"name\": {\"type\": \"string\", \"value\": \"Lance Uppercut\"}\n    },\n    \"servers\": {\n        \"alpha\": {\n            \"dc\": {\"type\": \"string\", \"value\": \"eqdc10\"},\n            \"ip\": {\"type\": \"string\", \"value\": \"10.0.0.1\"}\n        },\n        \"beta\": {\n            \"dc\": {\"type\": \"string\", \"value\": \"eqdc10\"},\n            \"ip\": {\"type\": \"string\", \"value\": \"10.0.0.2\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/string/basic-escape-01.toml",
      src: b"# Escape \"\x0atest = \"\\\"one\\\"\"\x0a",
      want: "{\n    \"test\": {\"type\": \"string\", \"value\": \"\\\"one\\\"\"}\n}\n",
    },
    {
      name: "valid/string/basic-escape-02.toml",
      src: b"# Escape \\ and then \"\x0atest = \"\\\\\\\"one\"\x0a",
      want: "{\n    \"test\": {\"type\": \"string\", \"value\": \"\\\\\\\"one\"}\n}\n",
    },
    {
      name: "valid/string/basic-escape-03.toml",
      src: b"# Escape \\ four times and then \"\x0atest = \"\\\\\\\\\\\\\\\\\\\"one\"\x0a",
      want: "{\n    \"test\": {\"type\": \"string\", \"value\": \"\\\\\\\\\\\\\\\\\\\"one\"}\n}\n",
    },
    {
      name: "valid/string/empty.toml",
      src: b"answer = \"\"\x0a",
      want: "{\n    \"answer\": {\"type\": \"string\", \"value\": \"\"}\n}\n",
    },
    {
      name: "valid/string/ends-in-whitespace-escape.toml",
      src: b"beee = \"\"\"\x0aheeee\x0ageeee\\  \x0a\x0a\x0a      \"\"\"\x0a",
      want: "{\n    \"beee\": {\"type\": \"string\", \"value\": \"heeee\\ngeeee\"}\n}\n",
    },
    {
      name: "valid/string/escape-esc.toml",
      src: b"esc = \"\\e There is no escape! \\e\"\x0a",
      want: "{\n    \"esc\": {\"type\": \"string\", \"value\": \"\\u001b There is no escape! \\u001b\"}\n}\n",
    },
    {
      name: "valid/string/escape-tricky.toml",
      src: b"end_esc = \"String does not end here\\\" but ends here\\\\\"\x0alit_end_esc = 'String ends here\\'\x0a\x0amultiline_unicode = \"\"\"\x0a\\u00a0\"\"\"\x0a\x0amultiline_not_unicode = \"\"\"\x0a\\\\u0041\"\"\"\x0a\x0amultiline_end_esc = \"\"\"When will it end? \\\"\"\"...\"\"\\\" should be here\\\"\"\"\"\x0a\x0alit_multiline_not_unicode = '''\x0a\\u007f'''\x0a\x0alit_multiline_end = '''There is no escape\\'''\x0a",
      want: "{\n    \"end_esc\":                   {\"type\": \"string\", \"value\": \"String does not end here\\\" but ends here\\\\\"},\n    \"lit_end_esc\":               {\"type\": \"string\", \"value\": \"String ends here\\\\\"},\n    \"lit_multiline_end\":         {\"type\": \"string\", \"value\": \"There is no escape\\\\\"},\n    \"lit_multiline_not_unicode\": {\"type\": \"string\", \"value\": \"\\\\u007f\"},\n    \"multiline_end_esc\":         {\"type\": \"string\", \"value\": \"When will it end? \\\"\\\"\\\"...\\\"\\\"\\\" should be here\\\"\"},\n    \"multiline_not_unicode\":     {\"type\": \"string\", \"value\": \"\\\\u0041\"},\n    \"multiline_unicode\":         {\"type\": \"string\", \"value\": \"\u{a0}\"}\n}\n",
    },
    {
      name: "valid/string/escaped-escape.toml",
      src: b"answer = \"\\\\x64\"\x0a",
      want: "{\n    \"answer\": {\"type\": \"string\", \"value\": \"\\\\x64\"}\n}\n",
    },
    {
      name: "valid/string/escapes.toml",
      src: b"backspace     = \"|\\b.\"\x0atab           = \"|\\t.\"\x0anewline       = \"|\\n.\"\x0aformfeed      = \"|\\f.\"\x0acarriage      = \"|\\r.\"\x0aquote         = \"|\\\".\"\x0abackslash     = \"|\\\\.\"\x0adelete        = \"|\\u007F.\"\x0aunitseparator = \"|\\u001F.\"\x0a\x0a# \\u is escaped, so should NOT be interperted as a \\u escape.\x0anotunicode1   = \"|\\\\u.\"\x0anotunicode2   = \"|\\u005Cu.\"\x0anotunicode3   = \"|\\\\u0075.\"\x0anotunicode4   = \"|\\\\\\u0075.\"\x0a",
      want: "{\n    \"backslash\":     {\"type\": \"string\", \"value\": \"|\\\\.\"},\n    \"backspace\":     {\"type\": \"string\", \"value\": \"|\\b.\"},\n    \"carriage\":      {\"type\": \"string\", \"value\": \"|\\r.\"},\n    \"delete\":        {\"type\": \"string\", \"value\": \"|\u{7f}.\"},\n    \"formfeed\":      {\"type\": \"string\", \"value\": \"|\\f.\"},\n    \"newline\":       {\"type\": \"string\", \"value\": \"|\\n.\"},\n    \"notunicode1\":   {\"type\": \"string\", \"value\": \"|\\\\u.\"},\n    \"notunicode2\":   {\"type\": \"string\", \"value\": \"|\\\\u.\"},\n    \"notunicode3\":   {\"type\": \"string\", \"value\": \"|\\\\u0075.\"},\n    \"notunicode4\":   {\"type\": \"string\", \"value\": \"|\\\\u.\"},\n    \"quote\":         {\"type\": \"string\", \"value\": \"|\\\".\"},\n    \"tab\":           {\"type\": \"string\", \"value\": \"|\\t.\"},\n    \"unitseparator\": {\"type\": \"string\", \"value\": \"|\\u001f.\"}\n}\n",
    },
    {
      name: "valid/string/hex-escape.toml",
      src: b"# \\x for the first 255 codepoints\x0a\x0awhitespace      = \"\\x20 \\x09 \\x1b \\x0d\\x0a\"\x0abs              = \"\\x7f\"\x0anul             = \"\\x00\"\x0ahello           = \"\\x68\\x65\\x6c\\x6c\\x6f\\x0a\"\x0ahigher-than-127 = \"S\\xf8rmirb\\xe6ren\"\x0a\x0amultiline = \"\"\"\x0a\\x20 \\x09 \\x1b \\x0d\\x0a\x0a\\x7f\x0a\\x00\x0a\\x68\\x65\\x6c\\x6c\\x6f\\x0a\x0a\\x53\\xF8\\x72\\x6D\\x69\\x72\\x62\\xE6\\x72\\x65\\x6E\x0a\"\"\"\x0a\x0a# Not inside literals.\x0aliteral = '\\x20 \\x09 \\x0d\\x0a'\x0amultiline-literal = '''\x0a\\x20 \\x09 \\x0d\\x0a\x0a'''\x0a",
      want: "{\n    \"bs\":                {\"type\": \"string\", \"value\": \"\u{7f}\"},\n    \"hello\":             {\"type\": \"string\", \"value\": \"hello\\n\"},\n    \"higher-than-127\":   {\"type\": \"string\", \"value\": \"S\u{f8}rmirb\u{e6}ren\"},\n    \"literal\":           {\"type\": \"string\", \"value\": \"\\\\x20 \\\\x09 \\\\x0d\\\\x0a\"},\n    \"multiline\":         {\"type\": \"string\", \"value\": \"  \\t \\u001b \\r\\n\\n\u{7f}\\n\\u0000\\nhello\\n\\nS\u{f8}rmirb\u{e6}ren\\n\"},\n    \"multiline-literal\": {\"type\": \"string\", \"value\": \"\\\\x20 \\\\x09 \\\\x0d\\\\x0a\\n\"},\n    \"nul\":               {\"type\": \"string\", \"value\": \"\\u0000\"},\n    \"whitespace\":        {\"type\": \"string\", \"value\": \"  \\t \\u001b \\r\\n\"}\n}\n",
    },
    {
      name: "valid/string/multibyte-escape.toml",
      src: b"# Test each multibyte length: 2, 3, and 4 bytes:\x0a# \xc9\x91 \xe2\x82\xac \xf0\x90\xab\xb1\x0a\x0abasic-1    = \"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\x0aml-basic-1 = \"\"\"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\"\"\x0a\x0a# Again, but only using \\U\x0abasic-2    = \"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\x0aml-basic-2 = \"\"\"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\"\"\x0a",
      want: "{\n    \"basic-1\":    {\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"},\n    \"ml-basic-1\": {\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"},\n    \"basic-2\":    {\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"},\n    \"ml-basic-2\": {\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"}\n}\n",
    },
    {
      name: "valid/string/multibyte.toml",
      src: b"# Test each multibyte length: 2, 3, and 4 bytes:\x0a# \xc9\x91 \xe2\x82\xac \xf0\x90\xab\xb1\x0a\x0abasic    = \"\xc9\x91 \xe2\x82\xac \xf0\x90\xab\xb1 \xc9\x91\xe2\x82\xac\xf0\x90\xab\xb1\"\x0araw      = '\xc9\x91 \xe2\x82\xac \xf0\x90\xab\xb1 \xc9\x91\xe2\x82\xac\xf0\x90\xab\xb1'\x0aml-basic = \"\"\"\xc9\x91 \xe2\x82\xac \xf0\x90\xab\xb1 \xc9\x91\xe2\x82\xac\xf0\x90\xab\xb1\"\"\"\x0aml-raw   = '''\xc9\x91 \xe2\x82\xac \xf0\x90\xab\xb1 \xc9\x91\xe2\x82\xac\xf0\x90\xab\xb1'''\x0a",
      want: "{\n    \"basic\":    {\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"},\n    \"ml-basic\": {\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"},\n    \"ml-raw\":   {\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"},\n    \"raw\":      {\"type\": \"string\", \"value\": \"\u{251} \u{20ac} \u{10af1} \u{251}\u{20ac}\u{10af1}\"}\n}\n",
    },
    {
      name: "valid/string/multiline-empty.toml",
      src: b"empty-1 = \"\"\"\"\"\"\x0a\x0a# A newline immediately following the opening delimiter will be trimmed.\x0aempty-2 = \"\"\"\x0a\"\"\"\x0a\x0a# \\ at the end of line trims newlines as well; note that last \\ is followed by\x0a# two spaces, which are ignored.\x0aempty-3 = \"\"\"\\\x0a    \"\"\"\x0aempty-4 = \"\"\"\\\x0a   \\\x0a   \\  \x0a   \"\"\"\x0a\x0a",
      want: "{\n    \"empty-1\": {\"type\": \"string\", \"value\": \"\"},\n    \"empty-2\": {\"type\": \"string\", \"value\": \"\"},\n    \"empty-3\": {\"type\": \"string\", \"value\": \"\"},\n    \"empty-4\": {\"type\": \"string\", \"value\": \"\"}\n}\n",
    },
    {
      name: "valid/string/multiline-escaped-crlf.toml",
      src: b"# The following line should be an unescaped backslash followed by a Windows\x0d\x0a# newline sequence (\"\\r\\n\")\x0d\x0a0=\"\"\"\\\x0d\x0a\"\"\"\x0d\x0a",
      want: "{\n    \"0\": {\"type\": \"string\", \"value\": \"\"}\n}\n",
    },
    {
      name: "valid/string/multiline-quotes.toml",
      src: b"# Make sure that quotes inside multiline strings are allowed, including right\x0a# after the opening '''/\"\"\" and before the closing '''/\"\"\"\x0a\x0alit_one = ''''one quote''''\x0alit_two = '''''two quotes'''''\x0alit_one_space = ''' 'one quote' '''\x0alit_two_space = ''' ''two quotes'' '''\x0a\x0aone = \"\"\"\"one quote\"\"\"\"\x0atwo = \"\"\"\"\"two quotes\"\"\"\"\"\x0aone_space = \"\"\" \"one quote\" \"\"\"\x0atwo_space = \"\"\" \"\"two quotes\"\" \"\"\"\x0a\x0amismatch1 = \"\"\"aaa'''bbb\"\"\"\x0amismatch2 = '''aaa\"\"\"bbb'''\x0a\x0a# Three opening \"\"\", then one escaped \", then two \"\" (allowed), and then three\x0a# closing \"\"\"\x0aescaped = \"\"\"lol\\\"\"\"\"\"\"\x0a\x0afive-quotes = \"\"\"\x0aClosing with five quotes\x0a\"\"\"\"\"\x0afour-quotes = \"\"\"\x0aClosing with four quotes\x0a\"\"\"\"\x0a",
      want: "{\n    \"escaped\":       {\"type\": \"string\", \"value\": \"lol\\\"\\\"\\\"\"},\n    \"five-quotes\":   {\"type\": \"string\", \"value\": \"Closing with five quotes\\n\\\"\\\"\"},\n    \"four-quotes\":   {\"type\": \"string\", \"value\": \"Closing with four quotes\\n\\\"\"},\n    \"lit_one\":       {\"type\": \"string\", \"value\": \"'one quote'\"},\n    \"lit_one_space\": {\"type\": \"string\", \"value\": \" 'one quote' \"},\n    \"lit_two\":       {\"type\": \"string\", \"value\": \"''two quotes''\"},\n    \"lit_two_space\": {\"type\": \"string\", \"value\": \" ''two quotes'' \"},\n    \"mismatch1\":     {\"type\": \"string\", \"value\": \"aaa'''bbb\"},\n    \"mismatch2\":     {\"type\": \"string\", \"value\": \"aaa\\\"\\\"\\\"bbb\"},\n    \"one\":           {\"type\": \"string\", \"value\": \"\\\"one quote\\\"\"},\n    \"one_space\":     {\"type\": \"string\", \"value\": \" \\\"one quote\\\" \"},\n    \"two\":           {\"type\": \"string\", \"value\": \"\\\"\\\"two quotes\\\"\\\"\"},\n    \"two_space\":     {\"type\": \"string\", \"value\": \" \\\"\\\"two quotes\\\"\\\" \"}\n}\n",
    },
  ]
}

///|
fn accepted_11_09() -> Array[Accepted] {
  [
    {
      name: "valid/string/multiline.toml",
      src: b"# NOTE: this file includes some literal tab characters.\x0a\x0aequivalent_one = \"The quick brown fox jumps over the lazy dog.\"\x0aequivalent_two = \"\"\"\x0aThe quick brown \\\x0a\x0a\x0a  fox jumps over \\\x0a    the lazy dog.\"\"\"\x0a\x0aequivalent_three = \"\"\"\\\x0a       The quick brown \\\x0a       fox jumps over \\\x0a       the lazy dog.\\\x0a       \"\"\"\x0a\x0awhitespace-after-bs = \"\"\"\\\x0a       The quick brown \\\x0a       fox jumps over \\   \x0a       the lazy dog.\\\x09\x0a       \"\"\"\x0a\x0ano-space = \"\"\"a\\\x0a    b\"\"\"\x0a\x0a# Has tab character.\x0akeep-ws-before = \"\"\"a   \x09\\\x0a   b\"\"\"\x0a\x0aescape-bs-1 = \"\"\"a \\\\\x0ab\"\"\"\x0a\x0aescape-bs-2 = \"\"\"a \\\\\\\x0ab\"\"\"\x0a\x0aescape-bs-3 = \"\"\"a \\\\\\\\\x0a  b\"\"\"\x0a",
      want: "{\n    \"equivalent_one\":      {\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"},\n    \"equivalent_three\":    {\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"},\n    \"equivalent_two\":      {\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"},\n    \"escape-bs-1\":         {\"type\": \"string\", \"value\": \"a \\\\\\nb\"},\n    \"escape-bs-2\":         {\"type\": \"string\", \"value\": \"a \\\\b\"},\n    \"escape-bs-3\":         {\"type\": \"string\", \"value\": \"a \\\\\\\\\\n  b\"},\n    \"keep-ws-before\":      {\"type\": \"string\", \"value\": \"a   \\tb\"},\n    \"no-space\":            {\"type\": \"string\", \"value\": \"ab\"},\n    \"whitespace-after-bs\": {\"type\": \"string\", \"value\": \"The quick brown fox jumps over the lazy dog.\"}\n}\n",
    },
    {
      name: "valid/string/nl.toml",
      src: b"nl_mid = \"val\\nue\"\x0anl_end = \"\"\"value\\n\"\"\"\x0a\x0alit_nl_end = '''value\\n'''\x0alit_nl_mid = 'val\\nue'\x0alit_nl_uni = 'val\\ue'\x0a",
      want: "{\n    \"lit_nl_end\": {\"type\": \"string\", \"value\": \"value\\\\n\"},\n    \"lit_nl_mid\": {\"type\": \"string\", \"value\": \"val\\\\nue\"},\n    \"lit_nl_uni\": {\"type\": \"string\", \"value\": \"val\\\\ue\"},\n    \"nl_end\":     {\"type\": \"string\", \"value\": \"value\\n\"},\n    \"nl_mid\":     {\"type\": \"string\", \"value\": \"val\\nue\"}\n}\n",
    },
    {
      name: "valid/string/quoted-unicode.toml",
      src: b"\x0aescaped_string = \"\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\"\x0anot_escaped_string = '\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff'\x0a\x0abasic_string = \"~ \xc2\x80 \xc3\xbf \xed\x9f\xbf \xee\x80\x80 \xef\xbf\xbf \xf0\x90\x80\x80 \xf4\x8f\xbf\xbf\"\x0aliteral_string = '~ \xc2\x80 \xc3\xbf \xed\x9f\xbf \xee\x80\x80 \xef\xbf\xbf \xf0\x90\x80\x80 \xf4\x8f\xbf\xbf'\x0a",
      want: "{\n    \"basic_string\":   {\"type\": \"string\", \"value\": \"~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\"},\n    \"escaped_string\": {\"type\": \"string\", \"value\": \"\\u0000 \\b \\f A \u{7f} \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\"},\n    \"literal_string\": {\"type\": \"string\", \"value\": \"~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\"},\n    \"not_escaped_string\": {\n        \"type\":  \"string\",\n        \"value\": \"\\\\u0000 \\\\u0008 \\\\u000c \\\\U00000041 \\\\u007f \\\\u0080 \\\\u00ff \\\\ud7ff \\\\ue000 \\\\uffff \\\\U00010000 \\\\U0010ffff\"\n    }\n}\n",
    },
    {
      name: "valid/string/raw-empty.toml",
      src: b"empty = ''\x0a",
      want: "{\n    \"empty\": {\"type\": \"string\", \"value\": \"\"}\n}\n",
    },
    {
      name: "valid/string/raw-multiline.toml",
      src: b"# Single ' should be allowed.\x0aoneline = '''This string has a ' quote character.'''\x0a\x0a# A newline immediately following the opening delimiter will be trimmed.\x0afirstnl = '''\x0aThis string has a ' quote character.'''\x0a\x0a# All other whitespace and newline characters remain intact.\x0amultiline = '''\x0aThis string\x0ahas ' a quote character\x0aand more than\x0aone newline\x0ain it.'''\x0a\x0a# Tab character in literal string does not need to be escaped\x0amultiline_with_tab = '''First line\x0a\x09 Followed by a tab'''\x0a\x0athis-str-has-apostrophes='''' there's one already\x0a'' two more\x0a'''''\x0a",
      want: "{\n    \"firstnl\":                  {\"type\": \"string\", \"value\": \"This string has a ' quote character.\"},\n    \"multiline\":                {\"type\": \"string\", \"value\": \"This string\\nhas ' a quote character\\nand more than\\none newline\\nin it.\"},\n    \"multiline_with_tab\":       {\"type\": \"string\", \"value\": \"First line\\n\\t Followed by a tab\"},\n    \"oneline\":                  {\"type\": \"string\", \"value\": \"This string has a ' quote character.\"},\n    \"this-str-has-apostrophes\": {\"type\": \"string\", \"value\": \"' there's one already\\n'' two more\\n''\"}\n}\n",
    },
    {
      name: "valid/string/raw.toml",
      src: b"backspace = 'This string has a \\b backspace character.'\x0atab = 'This string has a \\t tab character.'\x0aunescaped_tab = 'This string has an \x09 unescaped tab character.'\x0anewline = 'This string has a \\n new line character.'\x0aformfeed = 'This string has a \\f form feed character.'\x0acarriage = 'This string has a \\r carriage return character.'\x0aslash = 'This string has a \\/ slash character.'\x0abackslash = 'This string has a \\\\ backslash character.'\x0a",
      want: "{\n    \"backslash\":     {\"type\": \"string\", \"value\": \"This string has a \\\\\\\\ backslash character.\"},\n    \"backspace\":     {\"type\": \"string\", \"value\": \"This string has a \\\\b backspace character.\"},\n    \"carriage\":      {\"type\": \"string\", \"value\": \"This string has a \\\\r carriage return character.\"},\n    \"formfeed\":      {\"type\": \"string\", \"value\": \"This string has a \\\\f form feed character.\"},\n    \"newline\":       {\"type\": \"string\", \"value\": \"This string has a \\\\n new line character.\"},\n    \"slash\":         {\"type\": \"string\", \"value\": \"This string has a \\\\/ slash character.\"},\n    \"tab\":           {\"type\": \"string\", \"value\": \"This string has a \\\\t tab character.\"},\n    \"unescaped_tab\": {\"type\": \"string\", \"value\": \"This string has an \\t unescaped tab character.\"}\n}\n",
    },
    {
      name: "valid/string/simple.toml",
      src: b"answer = \"You are not drinking enough whisky.\"\x0a",
      want: "{\n    \"answer\": {\"type\": \"string\", \"value\": \"You are not drinking enough whisky.\"}\n}\n",
    },
    {
      name: "valid/string/start-mb.toml",
      src: b"# Start first line with a multibyte character.\x0a#\x0a# https://github.com/marzer/tomlplusplus/issues/190\x0as1 = \"\xc2\xa7\"\x0as2 = '\xc2\xa7'\x0as3 = \"\"\"\\\x0a\xc2\xa7\"\"\"\x0as4 = \"\"\"\x0a\xc2\xa7\"\"\"\x0as5 = \"\"\"\xc2\xa7\"\"\"\x0as6 = '''\x0a\xc2\xa7'''\x0as7 = '''\xc2\xa7'''\x0a",
      want: "{\n    \"s1\": {\"type\": \"string\", \"value\": \"\u{a7}\"},\n    \"s2\": {\"type\": \"string\", \"value\": \"\u{a7}\"},\n    \"s3\": {\"type\": \"string\", \"value\": \"\u{a7}\"},\n    \"s4\": {\"type\": \"string\", \"value\": \"\u{a7}\"},\n    \"s5\": {\"type\": \"string\", \"value\": \"\u{a7}\"},\n    \"s6\": {\"type\": \"string\", \"value\": \"\u{a7}\"},\n    \"s7\": {\"type\": \"string\", \"value\": \"\u{a7}\"}\n}\n",
    },
    {
      name: "valid/string/unicode-escape.toml",
      src: b"delta-1 = \"\\u03B4\"\x0adelta-2 = \"\\U000003B4\"\x0aa       = \"\\u0061\"\x0ab       = \"\\u0062\"\x0ac       = \"\\U00000063\"\x0anull-1  = \"\\u0000\"\x0anull-2  = \"\\U00000000\"\x0a\x0aml-delta-1 = \"\"\"\\u03B4\"\"\"\x0aml-delta-2 = \"\"\"\\U000003B4\"\"\"\x0aml-a       = \"\"\"\\u0061\"\"\"\x0aml-b       = \"\"\"\\u0062\"\"\"\x0aml-c       = \"\"\"\\U00000063\"\"\"\x0aml-null-1  = \"\"\"\\u0000\"\"\"\x0aml-null-2  = \"\"\"\\U00000000\"\"\"\x0a",
      want: "{\n    \"a\":          {\"type\": \"string\", \"value\": \"a\"},\n    \"b\":          {\"type\": \"string\", \"value\": \"b\"},\n    \"c\":          {\"type\": \"string\", \"value\": \"c\"},\n    \"delta-1\":    {\"type\": \"string\", \"value\": \"\u{3b4}\"},\n    \"delta-2\":    {\"type\": \"string\", \"value\": \"\u{3b4}\"},\n    \"ml-a\":       {\"type\": \"string\", \"value\": \"a\"},\n    \"ml-b\":       {\"type\": \"string\", \"value\": \"b\"},\n    \"ml-c\":       {\"type\": \"string\", \"value\": \"c\"},\n    \"ml-delta-1\": {\"type\": \"string\", \"value\": \"\u{3b4}\"},\n    \"ml-delta-2\": {\"type\": \"string\", \"value\": \"\u{3b4}\"},\n    \"ml-null-1\":  {\"type\": \"string\", \"value\": \"\\u0000\"},\n    \"ml-null-2\":  {\"type\": \"string\", \"value\": \"\\u0000\"},\n    \"null-1\":     {\"type\": \"string\", \"value\": \"\\u0000\"},\n    \"null-2\":     {\"type\": \"string\", \"value\": \"\\u0000\"}\n}\n",
    },
    {
      name: "valid/string/with-pound.toml",
      src: b"pound = \"We see no # comments here.\"\x0apoundcomment = \"But there are # some comments here.\" # Did I # mess you up?\x0a",
      want: "{\n    \"pound\":        {\"type\": \"string\", \"value\": \"We see no # comments here.\"},\n    \"poundcomment\": {\"type\": \"string\", \"value\": \"But there are # some comments here.\"}\n}\n",
    },
    {
      name: "valid/table/array-empty-name.toml",
      src: b"# Silly thing to do, but valid.\x0a\x0a[['']]\x0aa = 1\x0a[['']]\x0aa = 2\x0a",
      want: "{\n    \"\": [\n        {\"a\": {\"type\": \"integer\", \"value\": \"1\"}},\n        {\"a\": {\"type\": \"integer\", \"value\": \"2\"}}\n    ]\n}\n",
    },
    {
      name: "valid/table/array-empty.toml",
      src: b"[[a]]\x0a",
      want: "{\n    \"a\": [{}]\n}\n",
    },
    {
      name: "valid/table/array-implicit-and-explicit-after.toml",
      src: b"[[a.b]]\x0ax = 1\x0a\x0a[a]\x0ay = 2\x0a",
      want: "{\n    \"a\": {\n        \"b\": [{\n            \"x\": {\"type\": \"integer\", \"value\": \"1\"}\n        }],\n        \"y\": {\"type\": \"integer\", \"value\": \"2\"}\n    }\n}\n",
    },
    {
      name: "valid/table/array-implicit.toml",
      src: b"[[albums.songs]]\x0aname = \"Glory Days\"\x0a",
      want: "{\n    \"albums\": {\"songs\": [{\n        \"name\": {\"type\": \"string\", \"value\": \"Glory Days\"}\n    }]}\n}\n",
    },
    {
      name: "valid/table/array-many.toml",
      src: b"[[people]]\x0afirst_name = \"Bruce\"\x0alast_name = \"Springsteen\"\x0a\x0a[[people]]\x0afirst_name = \"Eric\"\x0alast_name = \"Clapton\"\x0a\x0a[[people]]\x0afirst_name = \"Bob\"\x0alast_name = \"Seger\"\x0a",
      want: "{\n    \"people\": [\n        {\n            \"first_name\": {\"type\": \"string\", \"value\": \"Bruce\"},\n            \"last_name\":  {\"type\": \"string\", \"value\": \"Springsteen\"}\n        },\n        {\n            \"first_name\": {\"type\": \"string\", \"value\": \"Eric\"},\n            \"last_name\":  {\"type\": \"string\", \"value\": \"Clapton\"}\n        },\n        {\n            \"first_name\": {\"type\": \"string\", \"value\": \"Bob\"},\n            \"last_name\":  {\"type\": \"string\", \"value\": \"Seger\"}\n        }\n    ]\n}\n",
    },
    {
      name: "valid/table/array-nest.toml",
      src: b"[[albums]]\x0aname = \"Born to Run\"\x0a\x0a  [[albums.songs]]\x0a  name = \"Jungleland\"\x0a\x0a  [[albums.songs]]\x0a  name = \"Meeting Across the River\"\x0a\x0a[[albums]]\x0aname = \"Born in the USA\"\x0a  \x0a  [[albums.songs]]\x0a  name = \"Glory Days\"\x0a\x0a  [[albums.songs]]\x0a  name = \"Dancing in the Dark\"\x0a",
      want: "{\n    \"albums\": [\n        {\n            \"name\": {\"type\": \"string\", \"value\": \"Born to Run\"},\n            \"songs\": [\n                {\n                    \"name\": {\"type\": \"string\", \"value\": \"Jungleland\"}\n                },\n                {\n                    \"name\": {\"type\": \"string\", \"value\": \"Meeting Across the River\"}\n                }\n            ]\n        },\n        {\n            \"name\": {\"type\": \"string\", \"value\": \"Born in the USA\"},\n            \"songs\": [\n                {\n                    \"name\": {\"type\": \"string\", \"value\": \"Glory Days\"}\n                },\n                {\n                    \"name\": {\"type\": \"string\", \"value\": \"Dancing in the Dark\"}\n                }\n            ]\n        }\n    ]\n}\n",
    },
    {
      name: "valid/table/array-one.toml",
      src: b"[[people]]\x0afirst_name = \"Bruce\"\x0alast_name = \"Springsteen\"\x0a",
      want: "{\n    \"people\": [{\n        \"first_name\": {\"type\": \"string\", \"value\": \"Bruce\"},\n        \"last_name\":  {\"type\": \"string\", \"value\": \"Springsteen\"}\n    }]\n}\n",
    },
    {
      name: "valid/table/array-table-array.toml",
      src: b"[[a]]\x0a    [[a.b]]\x0a        [a.b.c]\x0a            d = \"val0\"\x0a    [[a.b]]\x0a        [a.b.c]\x0a            d = \"val1\"\x0a",
      want: "{\n    \"a\": [{\n        \"b\": [\n            {\n                \"c\": {\n                    \"d\": {\"type\": \"string\", \"value\": \"val0\"}\n                }\n            },\n            {\n                \"c\": {\n                    \"d\": {\"type\": \"string\", \"value\": \"val1\"}\n                }\n            }\n        ]\n    }]\n}\n",
    },
    {
      name: "valid/table/array-within-dotted.toml",
      src: b"[fruit]\x0aapple.color = \"red\"\x0a\x0a[[fruit.apple.seeds]]\x0asize = 2\x0a",
      want: "{\n    \"fruit\": {\n        \"apple\": {\n            \"color\": {\"type\": \"string\", \"value\": \"red\"},\n            \"seeds\": [{\n                \"size\": {\"type\": \"integer\", \"value\": \"2\"}\n            }]\n        }\n    }\n}\n",
    },
    {
      name: "valid/table/empty-name.toml",
      src: b"['']\x0ax = 1\x0a\x0a[\"\".a]\x0ax = 2\x0a\x0a[a.'']\x0ax = 3\x0a",
      want: "{\n    \"\": {\n        \"x\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"a\": {\n            \"x\": {\"type\": \"integer\", \"value\": \"2\"}\n        }\n    },\n    \"a\": {\n        \"\": {\n            \"x\": {\"type\": \"integer\", \"value\": \"3\"}\n        }\n    }\n}\n",
    },
  ]
}

///|
fn accepted_11_10() -> Array[Accepted] {
  [
    {
      name: "valid/table/empty.toml",
      src: b"[a]\x0a",
      want: "{\n    \"a\": {}\n}\n",
    },
    {
      name: "valid/table/keyword-with-values.toml",
      src: b"[true]\x0ak = 1\x0a\x0a[false]\x0ak = 2\x0a\x0a[inf]\x0ak = 3\x0a\x0a[nan]\x0ak = 4\x0a",
      want: "{\n    \"false\": {\n        \"k\": {\"type\": \"integer\", \"value\": \"2\"}\n    },\n    \"inf\": {\n        \"k\": {\"type\": \"integer\", \"value\": \"3\"}\n    },\n    \"nan\": {\n        \"k\": {\"type\": \"integer\", \"value\": \"4\"}\n    },\n    \"true\": {\n        \"k\": {\"type\": \"integer\", \"value\": \"1\"}\n    }\n}\n",
    },
    {
      name: "valid/table/keyword.toml",
      src: b"[true]\x0a\x0a[false]\x0a\x0a[inf]\x0a\x0a[nan]\x0a\x0a\x0a",
      want: "{\n    \"false\": {},\n    \"inf\":   {},\n    \"nan\":   {},\n    \"true\":  {}\n}\n",
    },
    {
      name: "valid/table/names-with-values.toml",
      src: b"[a.b.c]\x0akey = 1\x0a\x0a[a.\"b.c\"]\x0akey = 2\x0a\x0a[a.'d.e']\x0akey = 3\x0a\x0a[a.' x ']\x0akey = 4\x0a\x0a[ d.e.f ]\x0akey = 5\x0a\x0a[ g . h . i ]\x0akey = 6\x0a\x0a[ j . \"\xca\x9e\" . 'l' ]\x0akey = 7\x0a\x0a[x.1.2]\x0akey = 8\x0a",
      want: "{\n    \"a\": {\n        \" x \": {\n            \"key\": {\"type\": \"integer\", \"value\": \"4\"}\n        },\n        \"b\": {\n            \"c\": {\n                \"key\": {\"type\": \"integer\", \"value\": \"1\"}\n            }\n        },\n        \"b.c\": {\n            \"key\": {\"type\": \"integer\", \"value\": \"2\"}\n        },\n        \"d.e\": {\n            \"key\": {\"type\": \"integer\", \"value\": \"3\"}\n        }\n    },\n    \"d\": {\n        \"e\": {\n            \"f\": {\n                \"key\": {\"type\": \"integer\", \"value\": \"5\"}\n            }\n        }\n    },\n    \"g\": {\n        \"h\": {\n            \"i\": {\n                \"key\": {\"type\": \"integer\", \"value\": \"6\"}\n            }\n        }\n    },\n    \"j\": {\n        \"\u{29e}\": {\n            \"l\": {\n                \"key\": {\"type\": \"integer\", \"value\": \"7\"}\n            }\n        }\n    },\n    \"x\": {\n        \"1\": {\n            \"2\": {\n                \"key\": {\"type\": \"integer\", \"value\": \"8\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/table/names.toml",
      src: b"[a.b.c]\x0a[a.\"b.c\"]\x0a[a.'d.e']\x0a[a.' x ']\x0a[ d.e.f ]\x0a[ g . h . i ]\x0a[ j . \"\xca\x9e\" . 'l' ]\x0a\x0a[x.1.2]\x0a",
      want: "{\n    \"a\": {\n        \" x \": {},\n        \"b.c\": {},\n        \"d.e\": {},\n        \"b\": {\n            \"c\": {}\n        }\n    },\n    \"d\": {\n        \"e\": {\n            \"f\": {}\n        }\n    },\n    \"g\": {\n        \"h\": {\n            \"i\": {}\n        }\n    },\n    \"j\": {\n        \"\u{29e}\": {\n            \"l\": {}\n        }\n    },\n    \"x\": {\n        \"1\": {\n            \"2\": {}\n        }\n    }\n}\n",
    },
    {
      name: "valid/table/no-eol.toml",
      src: b"[table]\x0a",
      want: "{\n    \"table\": {}\n}\n",
    },
    {
      name: "valid/table/sub-empty.toml",
      src: b"[a]\x0a[a.b]\x0a",
      want: "{\n    \"a\": {\n        \"b\": {}\n    }\n}\n",
    },
    {
      name: "valid/table/sub.toml",
      src: b"[a]\x0akey = 1\x0a\x0a# a.extend is a key inside the \"a\" table.\x0a[a.extend]\x0akey = 2\x0a\x0a[a.extend.more]\x0akey = 3\x0a",
      want: "{\n    \"a\": {\n        \"key\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"extend\": {\n            \"key\": {\"type\": \"integer\", \"value\": \"2\"},\n            \"more\": {\n                \"key\": {\"type\": \"integer\", \"value\": \"3\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/table/whitespace.toml",
      src: b"[\"valid key\"]\x0a",
      want: "{\n    \"valid key\": {}\n}\n",
    },
    {
      name: "valid/table/with-literal-string.toml",
      src: b"['a']\x0a[a.'\"b\"']\x0a[a.'\"b\"'.c]\x0aanswer = 42 \x0a",
      want: "{\n    \"a\": {\n        \"\\\"b\\\"\": {\n            \"c\": {\n                \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/table/with-pound.toml",
      src: b"[\"key#group\"]\x0aanswer = 42\x0a",
      want: "{\n    \"key#group\": {\n        \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n    }\n}\n",
    },
    {
      name: "valid/table/with-single-quotes.toml",
      src: b"['a']\x0a[a.'b']\x0a[a.'b'.c]\x0aanswer = 42 \x0a",
      want: "{\n    \"a\": {\n        \"b\": {\n            \"c\": {\n                \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/table/without-super-with-values.toml",
      src: b"# [x] you\x0a# [x.y] don't\x0a# [x.y.z] need these\x0a[x.y.z.w] # for this to work\x0aa = 1\x0ab = 2\x0a[x] # defining a super-table afterwards is ok\x0ac = 3\x0ad = 4\x0a",
      want: "{\n    \"x\": {\n        \"c\": {\"type\": \"integer\", \"value\": \"3\"},\n        \"d\": {\"type\": \"integer\", \"value\": \"4\"},\n        \"y\": {\n            \"z\": {\n                \"w\": {\n                    \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n                    \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n                }\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/table/without-super.toml",
      src: b"# [x] you\x0a# [x.y] don't\x0a# [x.y.z] need these\x0a[x.y.z.w] # for this to work\x0a[x] # defining a super-table afterwards is ok\x0a",
      want: "{\n    \"x\": {\n        \"y\": {\n            \"z\": {\n                \"w\": {}\n            }\n        }\n    }\n}\n",
    },
  ]
}

