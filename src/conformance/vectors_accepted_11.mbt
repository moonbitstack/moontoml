    {
      name: "valid/float/exponent.toml",
      src: b"lower = 3e2\x0aupper = 3E2\x0aneg = 3e-2\x0apos = 3E+2\x0azero = 3e0\x0apointlower = 3.1e2\x0apointupper = 3.1E2\x0aminustenth = -1E-1\x0a",
      want: "{\n    \"lower\":      {\"type\": \"float\", \"value\": \"300.0\"},\n    \"minustenth\": {\"type\": \"float\", \"value\": \"-0.1\"},\n    \"neg\":        {\"type\": \"float\", \"value\": \"0.03\"},\n    \"pointlower\": {\"type\": \"float\", \"value\": \"310.0\"},\n    \"pointupper\": {\"type\": \"float\", \"value\": \"310.0\"},\n    \"pos\":        {\"type\": \"float\", \"value\": \"300.0\"},\n    \"upper\":      {\"type\": \"float\", \"value\": \"300.0\"},\n    \"zero\":       {\"type\": \"float\", \"value\": \"3.0\"}\n}\n",
    },
    {
      name: "valid/float/float.toml",
      src: b"pi = 3.14\x0apospi = +3.14\x0anegpi = -3.14\x0azero-intpart = 0.123\x0aleading-zero-fractional = 0.0123\x0a",
      want: "{\n    \"negpi\":                   {\"type\": \"float\", \"value\": \"-3.14\"},\n    \"pi\":                      {\"type\": \"float\", \"value\": \"3.14\"},\n    \"pospi\":                   {\"type\": \"float\", \"value\": \"3.14\"},\n    \"zero-intpart\":            {\"type\": \"float\", \"value\": \"0.123\"},\n    \"leading-zero-fractional\": {\"type\": \"float\", \"value\": \"0.0123\"}\n}\n",
    },
    {
      name: "valid/float/inf-and-nan.toml",
      src: b"# We don't encode +nan and -nan back with the signs; many languages don't\x0a# support a sign on NaN (it doesn't really make much sense).\x0anan = nan\x0anan_neg = -nan\x0anan_plus = +nan\x0ainfinity = inf\x0ainfinity_neg = -inf\x0ainfinity_plus = +inf\x0a",
      want: "{\n    \"infinity\":      {\"type\": \"float\", \"value\": \"inf\"},\n    \"infinity_neg\":  {\"type\": \"float\", \"value\": \"-inf\"},\n    \"infinity_plus\": {\"type\": \"float\", \"value\": \"inf\"},\n    \"nan\":           {\"type\": \"float\", \"value\": \"nan\"},\n    \"nan_neg\":       {\"type\": \"float\", \"value\": \"nan\"},\n    \"nan_plus\":      {\"type\": \"float\", \"value\": \"nan\"}\n}\n",
    },
    {
      name: "valid/float/long.toml",
      src: b"longpi = 3.141592653589793\x0aneglongpi = -3.141592653589793\x0a",
      want: "{\n    \"longpi\":    {\"type\": \"float\", \"value\": \"3.141592653589793\"},\n    \"neglongpi\": {\"type\": \"float\", \"value\": \"-3.141592653589793\"}\n}\n",
    },
    {
      name: "valid/float/max-int.toml",
      src: b"# Maximum and minimum safe natural numbers.\x0amax_float =  9_007_199_254_740_991.0\x0amin_float = -9_007_199_254_740_991.0\x0a",
      want: "{\n    \"max_float\": {\"type\": \"float\", \"value\": \"9007199254740991\"},\n    \"min_float\": {\"type\": \"float\", \"value\": \"-9007199254740991\"}\n}\n",
    },
    {
      name: "valid/float/underscore.toml",
      src: b"before = 3_141.5927\x0aafter = 3141.592_7\x0aexponent = 3e1_4\x0a",
      want: "{\n    \"after\":    {\"type\": \"float\", \"value\": \"3141.5927\"},\n    \"before\":   {\"type\": \"float\", \"value\": \"3141.5927\"},\n    \"exponent\": {\"type\": \"float\", \"value\": \"3.0e14\"}\n}\n",
    },
    {
      name: "valid/float/zero.toml",
      src: b"zero = 0.0\x0asigned-pos = +0.0\x0asigned-neg = -0.0\x0aexponent = 0e0\x0aexponent-two-0 = 0e00\x0aexponent-signed-pos = +0e0\x0aexponent-signed-neg = -0e0\x0a",
      want: "{\n    \"exponent\":            {\"type\": \"float\", \"value\": \"0\"},\n    \"exponent-signed-neg\": {\"type\": \"float\", \"value\": \"-0\"},\n    \"exponent-signed-pos\": {\"type\": \"float\", \"value\": \"0\"},\n    \"exponent-two-0\":      {\"type\": \"float\", \"value\": \"0\"},\n    \"signed-neg\":          {\"type\": \"float\", \"value\": \"-0\"},\n    \"signed-pos\":          {\"type\": \"float\", \"value\": \"0\"},\n    \"zero\":                {\"type\": \"float\", \"value\": \"0\"}\n}\n",
    },
    {
      name: "valid/implicit-and-explicit-after.toml",
      src: b"[a.b.c]\x0aanswer = 42\x0a\x0a[a]\x0abetter = 43\x0a",
      want: "{\n    \"a\": {\n        \"better\": {\"type\": \"integer\", \"value\": \"43\"},\n        \"b\": {\n            \"c\": {\n                \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/implicit-and-explicit-before.toml",
      src: b"[a]\x0abetter = 43\x0a\x0a[a.b.c]\x0aanswer = 42\x0a",
      want: "{\n    \"a\": {\n        \"better\": {\"type\": \"integer\", \"value\": \"43\"},\n        \"b\": {\n            \"c\": {\n                \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/implicit-groups.toml",
      src: b"[a.b.c]\x0aanswer = 42\x0a",
      want: "{\n    \"a\": {\n        \"b\": {\n            \"c\": {\n                \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/inline-table/array-01.toml",
      src: b"arr = [ {'a'= 1}, {'a'= 2} ]\x0a\x0apeople = [{first_name = \"Bruce\", last_name = \"Springsteen\"},\x0a          {first_name = \"Eric\", last_name = \"Clapton\"},\x0a          {first_name = \"Bob\", last_name = \"Seger\"}]\x0a",
      want: "{\n    \"arr\": [\n        {\n            \"a\": {\"type\": \"integer\", \"value\": \"1\"}\n        },\n        {\n            \"a\": {\"type\": \"integer\", \"value\": \"2\"}\n        }\n    ],\n    \"people\": [\n        {\n            \"first_name\": {\"type\": \"string\", \"value\": \"Bruce\"},\n            \"last_name\":  {\"type\": \"string\", \"value\": \"Springsteen\"}\n        },\n        {\n            \"first_name\": {\"type\": \"string\", \"value\": \"Eric\"},\n            \"last_name\":  {\"type\": \"string\", \"value\": \"Clapton\"}\n        },\n        {\n            \"first_name\": {\"type\": \"string\", \"value\": \"Bob\"},\n            \"last_name\":  {\"type\": \"string\", \"value\": \"Seger\"}\n        }\n    ]\n}\n",
    },
    {
      name: "valid/inline-table/array-02.toml",
      src: b"# \"No newlines are allowed between the curly braces unless they are valid within\x0a# a value\"\x0a\x0aa = { a = [\x0a]}\x0a",
      want: "{\n    \"a\": {\"a\": []}\n}\n",
    },
    {
      name: "valid/inline-table/array-03.toml",
      src: b"b = { a = [\x0a\x09\x091,\x0a\x09\x092,\x0a\x09], b = [\x0a\x09\x093,\x0a\x09\x094,\x0a\x09]}\x0a",
      want: "{\n    \"b\": {\n        \"a\": [\n            {\"type\": \"integer\", \"value\": \"1\"},\n            {\"type\": \"integer\", \"value\": \"2\"}\n        ],\n        \"b\": [\n            {\"type\": \"integer\", \"value\": \"3\"},\n            {\"type\": \"integer\", \"value\": \"4\"}\n        ]\n    }\n}\n",
    },
    {
      name: "valid/inline-table/bool.toml",
      src: b"a = {a = true, b = false}\x0a",
      want: "{\n    \"a\": {\n        \"a\": {\"type\": \"bool\", \"value\": \"true\"},\n        \"b\": {\"type\": \"bool\", \"value\": \"false\"}\n    }\n}\n",
    },
    {
      name: "valid/inline-table/empty.toml",
      src: b"empty1 = {}\x0aempty2 = { }\x0aempty_in_array = [ { not_empty = 1 }, {} ]\x0aempty_in_array2 = [{},{not_empty=1}]\x0amany_empty = [{},{},{}]\x0anested_empty = {\"empty\"={}}\x0awith_cmt ={            }#nothing here\x0a",
      want: "{\n    \"empty1\":   {},\n    \"empty2\":   {},\n    \"with_cmt\": {},\n    \"empty_in_array\": [\n        {\n            \"not_empty\": {\"type\": \"integer\", \"value\": \"1\"}\n        },\n        {}\n    ],\n    \"empty_in_array2\": [\n        {},\n        {\n            \"not_empty\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    ],\n    \"many_empty\": [\n        {},\n        {},\n        {}\n    ],\n    \"nested_empty\": {\n        \"empty\": {}\n    }\n}\n",
    },
  ]
}

///|
fn accepted_11_03() -> Array[Accepted] {
  [
    {
      name: "valid/inline-table/end-in-bool.toml",
      src: b"black = { python=\">3.6\", version=\">=18.9b0\", allow_prereleases=true }\x0a",
      want: "{\n    \"black\": {\n        \"allow_prereleases\": {\"type\": \"bool\", \"value\": \"true\"},\n        \"python\":            {\"type\": \"string\", \"value\": \"\\u003e3.6\"},\n        \"version\":           {\"type\": \"string\", \"value\": \"\\u003e=18.9b0\"}\n    }\n}\n",
    },
    {
      name: "valid/inline-table/inline-table.toml",
      src: b"name        = { first = \"Tom\", last = \"Preston-Werner\" }\x0apoint       = { x = 1, y = 2 }\x0asimple      = { a = 1 }\x0astr-key     = { \"a\" = 1 }\x0atable-array = [{ \"a\" = 1 }, { \"b\" = 2 }]\x0a",
      want: "{\n    \"name\": {\n        \"first\": {\"type\": \"string\", \"value\": \"Tom\"},\n        \"last\":  {\"type\": \"string\", \"value\": \"Preston-Werner\"}\n    },\n    \"point\": {\n        \"x\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"y\": {\"type\": \"integer\", \"value\": \"2\"}\n    },\n    \"simple\": {\n        \"a\": {\"type\": \"integer\", \"value\": \"1\"}\n    },\n    \"str-key\": {\n        \"a\": {\"type\": \"integer\", \"value\": \"1\"}\n    },\n    \"table-array\": [\n        {\n            \"a\": {\"type\": \"integer\", \"value\": \"1\"}\n        },\n        {\n            \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n        }\n    ]\n}\n",
    },
    {
      name: "valid/inline-table/key-dotted-01.toml",
      src: b"a = {   a.b  =  1   }\x0ab = {   \"a\".\"b\"  =  1   }\x0ac = {   a   .   b  =  1   }\x0ad = {   'a'   .   \"b\"  =  1   }\x0ae = {a.b=1}\x0a",
      want: "{\n    \"a\": {\n        \"a\": {\n            \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    },\n    \"b\": {\n        \"a\": {\n            \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    },\n    \"c\": {\n        \"a\": {\n            \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    },\n    \"d\": {\n        \"a\": {\n            \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    },\n    \"e\": {\n        \"a\": {\n            \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/inline-table/key-dotted-02.toml",
      src: b"many.dots.here.dot.dot.dot = {a.b.c = 1, a.b.d = 2}\x0a",
      want: "{\n    \"many\": {\n        \"dots\": {\n            \"here\": {\n                \"dot\": {\n                    \"dot\": {\n                        \"dot\": {\n                            \"a\": {\n                                \"b\": {\n                                    \"c\": {\"type\": \"integer\", \"value\": \"1\"},\n                                    \"d\": {\"type\": \"integer\", \"value\": \"2\"}\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/inline-table/key-dotted-03.toml",
      src: b"[tbl]\x0aa.b.c = {d.e=1}\x0a\x0a[tbl.x]\x0aa.b.c = {d.e=1}\x0a",
      want: "{\n    \"tbl\": {\n        \"a\": {\n            \"b\": {\n                \"c\": {\n                    \"d\": {\n                        \"e\": {\"type\": \"integer\", \"value\": \"1\"}\n                    }\n                }\n            }\n        },\n        \"x\": {\n            \"a\": {\n                \"b\": {\n                    \"c\": {\n                        \"d\": {\n                            \"e\": {\"type\": \"integer\", \"value\": \"1\"}\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n",
    },
    {
      name: "valid/inline-table/key-dotted-04.toml",
      src: b"[[arr]]\x0at = {a.b=1}\x0aT = {a.b=1}\x0a\x0a[[arr]]\x0at = {a.b=2}\x0aT = {a.b=2}\x0a",
      want: "{\n    \"arr\": [\n        {\n            \"T\": {\n                \"a\": {\n                    \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n                }\n            },\n            \"t\": {\n                \"a\": {\n                    \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n                }\n            }\n        },\n        {\n            \"T\": {\n                \"a\": {\n                    \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n                }\n            },\n            \"t\": {\n                \"a\": {\n                    \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n                }\n            }\n        }\n    ]\n}\n",
    },
    {
      name: "valid/inline-table/key-dotted-05.toml",
      src: b"arr-1 = [{a.b = 1}]\x0aarr-2 = [\"str\", {a.b = 1}]\x0a\x0aarr-3 = [{a.b = 1}, {a.b = 2}]\x0aarr-4 = [\"str\", {a.b = 1}, {a.b = 2}]\x0a",
      want: "{\n    \"arr-1\": [{\n        \"a\": {\n            \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    }],\n    \"arr-2\": [\n        {\"type\": \"string\", \"value\": \"str\"},\n        {\n            \"a\": {\n                \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n            }\n        }\n    ],\n    \"arr-3\": [\n        {\n            \"a\": {\n                \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n            }\n        },\n        {\n            \"a\": {\n                \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n            }\n        }\n    ],\n    \"arr-4\": [\n        {\"type\": \"string\", \"value\": \"str\"},\n        {\n            \"a\": {\n                \"b\": {\"type\": \"integer\", \"value\": \"1\"}\n            }\n        },\n        {\n            \"a\": {\n                \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n            }\n        }\n    ]\n}\n",
    },
    {
      name: "valid/inline-table/key-dotted-06.toml",
      src: b"top.dot.dot = [\x0a\x09{dot.dot.dot = 1},\x0a\x09{dot.dot.dot = 2},\x0a]\x0a",
      want: "{\n    \"top\": {\n        \"dot\": {\n            \"dot\": [\n                {\n                    \"dot\": {\n                        \"dot\": {\n                            \"dot\": {\"type\": \"integer\", \"value\": \"1\"}\n                        }\n                    }\n                },\n                {\n                    \"dot\": {\n                        \"dot\": {\n                            \"dot\": {\"type\": \"integer\", \"value\": \"2\"}\n                        }\n                    }\n                }\n            ]\n        }\n    }\n}\n",
    },
    {
      name: "valid/inline-table/key-dotted-07.toml",
      src: b"arr = [\x0a\x09{a.b = [{c.d = 1}]}\x0a]\x0a",
      want: "{\n    \"arr\": [{\n        \"a\": {\"b\": [{\n            \"c\": {\n                \"d\": {\"type\": \"integer\", \"value\": \"1\"}\n            }\n        }]}\n    }]\n}\n",
    },
    {
      name: "valid/inline-table/multiline.toml",
      src: b"tbl_multiline = { a = 1, b = \"\"\"\x0amultiline\x0a\"\"\", c = \"\"\"and yet\x0aanother line\"\"\", d = 4 }\x0a",
      want: "{\n    \"tbl_multiline\": {\n        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"b\": {\"type\": \"string\", \"value\": \"multiline\\n\"},\n        \"c\": {\"type\": \"string\", \"value\": \"and yet\\nanother line\"},\n        \"d\": {\"type\": \"integer\", \"value\": \"4\"}\n    }\n}\n",
    },
    {
      name: "valid/inline-table/nest.toml",
      src: b"tbl_tbl_empty = { tbl_0 = {} }\x0atbl_tbl_val   = { tbl_1 = { one = 1 } }\x0atbl_arr_tbl   = { arr_tbl = [ { one = 1 } ] }\x0aarr_tbl_tbl   = [ { tbl = { one = 1 } } ]\x0a\x0a# Array-of-array-of-table is interesting because it can only\x0a# be represented in inline form.\x0aarr_arr_tbl_empty = [ [ {} ] ]\x0aarr_arr_tbl_val = [ [ { one = 1 } ] ]\x0aarr_arr_tbls  = [ [ { one = 1 }, { two = 2 } ] ]\x0a",
      want: "{\n    \"arr_arr_tbl_empty\": [[{}]],\n    \"arr_arr_tbl_val\":   [[{\n        \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n    }]],\n    \"arr_arr_tbls\":      [[\n        {\n            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n        },\n        {\n            \"two\": {\"type\": \"integer\", \"value\": \"2\"}\n        }\n    ]],\n    \"arr_tbl_tbl\":       [{\n        \"tbl\": {\n            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    }],\n    \"tbl_arr_tbl\":       {\"arr_tbl\": [{\n        \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n    }]},\n    \"tbl_tbl_empty\": {\n        \"tbl_0\": {}\n    },\n    \"tbl_tbl_val\": {\n        \"tbl_1\": {\n            \"one\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/inline-table/newline-comment.toml",
      src: b"# Identical to newline.toml, but with comments that shouldn't affect the\x0a# results.\x0a\x0atrailing-comma-1 = {#comment\x0a\x09# comment\x0a\x09c = 1,#comment\x0a\x09#comment\x0a}#comment\x0atrailing-comma-2 = { c = 1, }#comment\x0a\x0atbl-1 = {#comment\x0a\x09hello = \"world\",#comment\x0a\x091     = 2,#comment\x0a\x09arr   = [1,#comment\x0a\x09         2,#comment\x0a\x09         3,#comment\x0a\x09        ],#comment\x0a\x09tbl = {#comment\x0a\x09\x09 k = 1,#comment\x0a\x09}#comment\x0a}#comment\x0a\x0atbl-2 = {#comment\x0a\x09k = \"\"\"\x0a\x09Hello\x0a\x09\"\"\"#comment\x0a}#comment\x0a",
      want: "{\n    \"tbl-1\": {\n        \"1\":     {\"type\": \"integer\", \"value\": \"2\"},\n        \"hello\": {\"type\": \"string\", \"value\": \"world\"},\n        \"arr\": [\n            {\"type\": \"integer\", \"value\": \"1\"},\n            {\"type\": \"integer\", \"value\": \"2\"},\n            {\"type\": \"integer\", \"value\": \"3\"}\n        ],\n        \"tbl\": {\n            \"k\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    },\n    \"tbl-2\": {\n        \"k\": {\"type\": \"string\", \"value\": \"\\tHello\\n\\t\"}\n    },\n    \"trailing-comma-1\": {\n        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n    },\n    \"trailing-comma-2\": {\n        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n    }\n}\n",
    },
    {
      name: "valid/inline-table/newline.toml",
      src: b"# TOML 1.1 supports newlines in inline tables and trailing commas.\x0a\x0atrailing-comma-1 = {\x0a\x09c = 1,\x0a}\x0atrailing-comma-2 = { c = 1, }\x0a\x0atbl-1 = {\x0a\x09hello = \"world\",\x0a\x091     = 2,\x0a\x09arr   = [1,\x0a\x09         2,\x0a\x09         3,\x0a\x09        ],\x0a\x09tbl = {\x0a\x09\x09 k = 1,\x0a\x09}\x0a}\x0a\x0atbl-2 = {\x0a\x09k = \"\"\"\x0a\x09Hello\x0a\x09\"\"\"\x0a}\x0a\x0ano-newline-before-brace = {\x0aa = 1,\x0ab = 2}\x0a\x0ano-newline-before-brace-with-comma = {\x0aa = 1,\x0ab = 2,}\x0a",
      want: "{\n    \"no-newline-before-brace\": {\n        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n    },\n    \"no-newline-before-brace-with-comma\": {\n        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"b\": {\"type\": \"integer\", \"value\": \"2\"}\n    },\n    \"tbl-1\": {\n        \"1\":     {\"type\": \"integer\", \"value\": \"2\"},\n        \"hello\": {\"type\": \"string\", \"value\": \"world\"},\n        \"arr\": [\n            {\"type\": \"integer\", \"value\": \"1\"},\n            {\"type\": \"integer\", \"value\": \"2\"},\n            {\"type\": \"integer\", \"value\": \"3\"}\n        ],\n        \"tbl\": {\n            \"k\": {\"type\": \"integer\", \"value\": \"1\"}\n        }\n    },\n    \"tbl-2\": {\n        \"k\": {\"type\": \"string\", \"value\": \"\\tHello\\n\\t\"}\n    },\n    \"trailing-comma-1\": {\n        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n    },\n    \"trailing-comma-2\": {\n        \"c\": {\"type\": \"integer\", \"value\": \"1\"}\n    }\n}\n",
    },
    {
      name: "valid/inline-table/spaces.toml",
      src: b"# https://github.com/toml-lang/toml-test/issues/146\x0aclap-1 = { version = \"4\"  , features = [\"derive\", \"cargo\"] }\x0a\x0a# Contains some literal tabs!\x0aclap-2 = { version = \"4\"\x09   \x09,\x09  \x09features = [   \"derive\" \x09  ,  \x09  \"cargo\"   ]   , nest   =   {  \x09  \"a\"   =   'x'  , \x09  'b'   = [ 1.5    ,   9.0  ]  }  }\x0a",
      want: "{\n    \"clap-1\": {\n        \"version\": {\"type\": \"string\", \"value\": \"4\"},\n        \"features\": [\n            {\"type\": \"string\", \"value\": \"derive\"},\n            {\"type\": \"string\", \"value\": \"cargo\"}\n        ]\n    },\n    \"clap-2\": {\n        \"version\": {\"type\": \"string\", \"value\": \"4\"},\n        \"features\": [\n            {\"type\": \"string\", \"value\": \"derive\"},\n            {\"type\": \"string\", \"value\": \"cargo\"}\n        ],\n        \"nest\": {\n            \"a\": {\"type\": \"string\", \"value\": \"x\"},\n            \"b\": [\n                {\"type\": \"float\", \"value\": \"1.5\"},\n                {\"type\": \"float\", \"value\": \"9\"}\n            ]\n        }\n    }\n}\n",
    },
    {
      name: "valid/integer/float64-max.toml",
      src: b"# Maximum and minimum safe float64 natural numbers. Mainly here for\x0a# -int-as-float.\x0amax_int =  9_007_199_254_740_991\x0amin_int = -9_007_199_254_740_991\x0a",
      want: "{\n    \"max_int\": {\"type\": \"integer\", \"value\": \"9007199254740991\"},\n    \"min_int\": {\"type\": \"integer\", \"value\": \"-9007199254740991\"}\n}\n",
    },
    {
      name: "valid/integer/integer.toml",
      src: b"answer = 42\x0aposanswer = +42\x0aneganswer = -42\x0azero = 0\x0a",
      want: "{\n    \"answer\":    {\"type\": \"integer\", \"value\": \"42\"},\n    \"neganswer\": {\"type\": \"integer\", \"value\": \"-42\"},\n    \"posanswer\": {\"type\": \"integer\", \"value\": \"42\"},\n    \"zero\":      {\"type\": \"integer\", \"value\": \"0\"}\n}\n",
    },
    {
      name: "valid/integer/literals.toml",
      src: b"bin1 = 0b11010110\x0abin2 = 0b1_0_1\x0a\x0aoct1 = 0o01234567\x0aoct2 = 0o755\x0aoct3 = 0o7_6_5\x0a\x0ahex1 = 0xDEADBEEF\x0ahex2 = 0xdeadbeef\x0ahex3 = 0xdead_beef\x0ahex4 = 0x00987\x0a",
      want: "{\n    \"bin1\": {\"type\": \"integer\", \"value\": \"214\"},\n    \"bin2\": {\"type\": \"integer\", \"value\": \"5\"},\n    \"hex1\": {\"type\": \"integer\", \"value\": \"3735928559\"},\n    \"hex2\": {\"type\": \"integer\", \"value\": \"3735928559\"},\n    \"hex3\": {\"type\": \"integer\", \"value\": \"3735928559\"},\n    \"hex4\": {\"type\": \"integer\", \"value\": \"2439\"},\n    \"oct1\": {\"type\": \"integer\", \"value\": \"342391\"},\n    \"oct2\": {\"type\": \"integer\", \"value\": \"493\"},\n    \"oct3\": {\"type\": \"integer\", \"value\": \"501\"}\n}\n",
    },
    {
      name: "valid/integer/long.toml",
      src: b"# int64 \"should\" be supported, but is not mandatory. It's fine to skip this\x0a# test.\x0aint64-max     = 9223372036854775807\x0aint64-max-neg = -9223372036854775808\x0a",
      want: "{\n    \"int64-max\":     {\"type\": \"integer\", \"value\": \"9223372036854775807\"},\n    \"int64-max-neg\": {\"type\": \"integer\", \"value\": \"-9223372036854775808\"}\n}\n",
    },
    {
      name: "valid/integer/underscore.toml",
      src: b"kilo = 1_000\x0ax = 1_1_1_1\x0a",
      want: "{\n    \"kilo\": {\"type\": \"integer\", \"value\": \"1000\"},\n    \"x\":    {\"type\": \"integer\", \"value\": \"1111\"}\n}\n",
    },
    {
      name: "valid/integer/zero.toml",
      src: b"d1 = 0\x0ad2 = +0\x0ad3 = -0\x0a\x0ah1 = 0x0\x0ah2 = 0x00\x0ah3 = 0x00000\x0a\x0ao1 = 0o0\x0aa2 = 0o00\x0aa3 = 0o00000\x0a\x0ab1 = 0b0\x0ab2 = 0b00\x0ab3 = 0b00000\x0a",
      want: "{\n    \"a2\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"a3\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"b1\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"b2\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"b3\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"d1\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"d2\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"d3\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"h1\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"h2\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"h3\": {\"type\": \"integer\", \"value\": \"0\"},\n    \"o1\": {\"type\": \"integer\", \"value\": \"0\"}\n}\n",
    },
  ]
}

///|
fn accepted_11_04() -> Array[Accepted] {
  [
    {
      name: "valid/key/alphanum.toml",
      src: b"alpha = \"a\"\x0a123 = \"num\"\x0a000111 = \"leading\"\x0a10e3 = \"false float\"\x0aone1two2 = \"mixed\"\x0awith-dash = \"dashed\"\x0aunder_score = \"___\"\x0a34-11 = 23\x0a\x0a[2018_10]\x0a001 = 1\x0a\x0a[a-a-a]\x0a_ = false\x0a",
      want: "{\n    \"000111\":      {\"type\": \"string\", \"value\": \"leading\"},\n    \"10e3\":        {\"type\": \"string\", \"value\": \"false float\"},\n    \"123\":         {\"type\": \"string\", \"value\": \"num\"},\n    \"34-11\":       {\"type\": \"integer\", \"value\": \"23\"},\n    \"alpha\":       {\"type\": \"string\", \"value\": \"a\"},\n    \"one1two2\":    {\"type\": \"string\", \"value\": \"mixed\"},\n    \"under_score\": {\"type\": \"string\", \"value\": \"___\"},\n    \"with-dash\":   {\"type\": \"string\", \"value\": \"dashed\"},\n    \"2018_10\": {\n        \"001\": {\"type\": \"integer\", \"value\": \"1\"}\n    },\n    \"a-a-a\": {\n        \"_\": {\"type\": \"bool\", \"value\": \"false\"}\n    }\n}\n",
    },
    {
      name: "valid/key/case-sensitive.toml",
      src: b"sectioN = \"NN\"\x0a\x0a[section]\x0aname = \"lower\"\x0aNAME = \"upper\"\x0aName = \"capitalized\"\x0a\x0a[Section]\x0aname = \"different section!!\"\x0a\"\xce\xbc\" = \"greek small letter mu\"\x0a\"\xce\x9c\" = \"greek capital letter MU\"\x0aM = \"latin letter M\"\x0a\x0a",
      want: "{\n    \"sectioN\": {\"type\": \"string\", \"value\": \"NN\"},\n    \"Section\": {\n        \"M\":    {\"type\": \"string\", \"value\": \"latin letter M\"},\n        \"name\": {\"type\": \"string\", \"value\": \"different section!!\"},\n        \"\u{39c}\":    {\"type\": \"string\", \"value\": \"greek capital letter MU\"},\n        \"\u{3bc}\":    {\"type\": \"string\", \"value\": \"greek small letter mu\"}\n    },\n    \"section\": {\n        \"NAME\": {\"type\": \"string\", \"value\": \"upper\"},\n        \"Name\": {\"type\": \"string\", \"value\": \"capitalized\"},\n        \"name\": {\"type\": \"string\", \"value\": \"lower\"}\n    }\n}\n",
    },
    {
      name: "valid/key/dotted-01.toml",
      src: b"name.first = \"Arthur\"\x0a\"name\".'last' = \"Dent\"\x0a\x0amany.dots.dot.dot.dot = 42\x0a",
      want: "{\n    \"many\": {\n        \"dots\": {\n            \"dot\": {\n                \"dot\": {\n                    \"dot\": {\"type\": \"integer\", \"value\": \"42\"}\n                }\n            }\n        }\n    },\n    \"name\": {\n        \"first\": {\"type\": \"string\", \"value\": \"Arthur\"},\n        \"last\":  {\"type\": \"string\", \"value\": \"Dent\"}\n    }\n}\n",
    },
    {
      name: "valid/key/dotted-02.toml",
      src: b"# Note: this file contains literal tab characters.\x0a\x0a# Space are ignored, and key parts can be quoted.\x0acount.a       = 1\x0acount . b     = 2\x0a\"count\".\"c\"   = 3\x0a\"count\" . \"d\" = 4\x0a'count'.'e'   = 5\x0a'count' . 'f' = 6\x0a\"count\".'g'   = 7\x0a\"count\" . 'h' = 8\x0acount.'i'     = 9\x0acount \x09.\x09 'j'\x09   = 10\x0a\"count\".k     = 11\x0a\"count\" . l   = 12\x0a",
      want: "{\n    \"count\": {\n        \"a\": {\"type\": \"integer\", \"value\": \"1\"},\n        \"b\": {\"type\": \"integer\", \"value\": \"2\"},\n        \"c\": {\"type\": \"integer\", \"value\": \"3\"},\n        \"d\": {\"type\": \"integer\", \"value\": \"4\"},\n        \"e\": {\"type\": \"integer\", \"value\": \"5\"},\n        \"f\": {\"type\": \"integer\", \"value\": \"6\"},\n        \"g\": {\"type\": \"integer\", \"value\": \"7\"},\n        \"h\": {\"type\": \"integer\", \"value\": \"8\"},\n        \"i\": {\"type\": \"integer\", \"value\": \"9\"},\n        \"j\": {\"type\": \"integer\", \"value\": \"10\"},\n        \"k\": {\"type\": \"integer\", \"value\": \"11\"},\n        \"l\": {\"type\": \"integer\", \"value\": \"12\"}\n    }\n}\n",
    },
    {
      name: "valid/key/dotted-03.toml",
      src: b"top.key = 1\x0a\x0a[tbl]\x0aa.b.c = 42.666\x0a\x0a[a.few.dots]\x0apolka.dot = \"again?\"\x0apolka.dance-with = \"Dot\"\x0a\x0a",
      want: "{\n    \"a\": {\n        \"few\": {\n            \"dots\": {\n                \"polka\": {\n                    \"dance-with\": {\"type\": \"string\", \"value\": \"Dot\"},\n                    \"dot\":        {\"type\": \"string\", \"value\": \"again?\"}\n                }\n            }\n        }\n    },\n    \"tbl\": {\n        \"a\": {\n            \"b\": {\n                \"c\": {\"type\": \"float\", \"value\": \"42.666\"}\n            }\n        }\n    },\n    \"top\": {\n        \"key\": {\"type\": \"integer\", \"value\": \"1\"}\n    }\n}\n",
    },
    {
      name: "valid/key/dotted-04.toml",
      src: b"top.key = 1\x0a\x0a[[arr]]\x0aa.b.c=1\x0aa.b.d=2\x0a\x0a[[arr]]\x0aa.b.c=3\x0aa.b.d=4\x0a\x0a",
      want: "{\n    \"arr\": [\n        {\n            \"a\": {\n                \"b\": {\n                    \"c\": {\"type\": \"integer\", \"value\": \"1\"},\n                    \"d\": {\"type\": \"integer\", \"value\": \"2\"}\n                }\n            }\n        },\n        {\n            \"a\": {\n                \"b\": {\n                    \"c\": {\"type\": \"integer\", \"value\": \"3\"},\n                    \"d\": {\"type\": \"integer\", \"value\": \"4\"}\n                }\n            }\n        }\n    ],\n    \"top\": {\n        \"key\": {\"type\": \"integer\", \"value\": \"1\"}\n    }\n}\n",
    },
    {
      name: "valid/key/dotted-empty.toml",
      src: b"''.x = \"empty.x\"\x0ax.\"\" = \"x.empty\"\x0a[a]\x0a\"\".'' = \"empty.empty\"\x0a",
      want: "{\n    \"\": {\n        \"x\": {\"type\": \"string\", \"value\": \"empty.x\"}\n    },\n    \"a\": {\n        \"\": {\n            \"\": {\"type\": \"string\", \"value\": \"empty.empty\"}\n        }\n    },\n    \"x\": {\n        \"\": {\"type\": \"string\", \"value\": \"x.empty\"}\n    }\n}\n",
    },
    {
      name: "valid/key/empty-01.toml",
      src: b"\"\" = \"blank\"\x0a",
      want: "{\n    \"\": {\"type\": \"string\", \"value\": \"blank\"}\n}\n",
    },
    {
      name: "valid/key/empty-02.toml",
      src: b"'' = \"blank\"\x0a",
      want: "{\n    \"\": {\"type\": \"string\", \"value\": \"blank\"}\n}\n",
    },
    {
      name: "valid/key/empty-03.toml",
      src: b"''=0\x0a",
      want: "{\n    \"\": {\"type\": \"integer\", \"value\": \"0\"}\n}\n",
    },
    {
      name: "valid/key/equals-nospace.toml",
      src: b"answer=42\x0a",
      want: "{\n    \"answer\": {\"type\": \"integer\", \"value\": \"42\"}\n}\n",
    },
    {
      name: "valid/key/escapes.toml",
      src: b"\"\\n\" = \"newline\"\x0a\"\\b\" = \"bell\"\x0a\"\\u00c0\" = \"latin capital letter A with grave\"\x0a\"\\\"\" = \"just a quote\"\x0a\x0a[\"backsp\\b\\b\"]\x0a\x0a[\"\\\"quoted\\\"\"]\x0aquote = true\x0a\x0a[\"a.b\".\"\\u00c0\"]\x0a",
      want: "{\n    \"\\b\":         {\"type\": \"string\", \"value\": \"bell\"},\n    \"\\n\":         {\"type\": \"string\", \"value\": \"newline\"},\n    \"\\\"\":         {\"type\": \"string\", \"value\": \"just a quote\"},\n    \"backsp\\b\\b\": {},\n    \"\u{c0}\":          {\"type\": \"string\", \"value\": \"latin capital letter A with grave\"},\n    \"\\\"quoted\\\"\": {\n        \"quote\": {\"type\": \"bool\", \"value\": \"true\"}\n    },\n    \"a.b\": {\n        \"\u{c0}\": {}\n    }\n}\n",
    },
    {
      name: "valid/key/like-date.toml",
      src: b"# '-' is a valid character in keys: make a key that looks like a date.\x0a2001-02-03   = 1\x0a\"2001-02-04\" = 2\x0a'2001-02-05' = 3\x0a\x0a# Also include datetime and time for good measure; these need to be quoted as\x0a# ':' isn't a valid bare key.\x0a\"2001-02-06T15:16:17+01:00\" = 4\x0a\"2001-02-07T15:16:17\"       = 5\x0a\"15:16:17\"                  = 6\x0a\x0a# Dotted keys\x0aa.2001-02-08 = 7\x0aa.2001-02-09.2001-02-10 = 8\x0a2001-02-11.a.2001-02-12 = 9\x0a\x0a# Table names\x0a[2002-01-02]\x0ak = 10\x0a\x0a[2002-01-02.2024-01-03]\x0ak = 11\x0a\x0a[[2002-01-04]]\x0ak = 12\x0a",
      want: "{\n    \"15:16:17\":                  {\"type\": \"integer\", \"value\": \"6\"},\n    \"2001-02-03\":                {\"type\": \"integer\", \"value\": \"1\"},\n    \"2001-02-04\":                {\"type\": \"integer\", \"value\": \"2\"},\n    \"2001-02-05\":                {\"type\": \"integer\", \"value\": \"3\"},\n    \"2001-02-06T15:16:17+01:00\": {\"type\": \"integer\", \"value\": \"4\"},\n    \"2001-02-07T15:16:17\":       {\"type\": \"integer\", \"value\": \"5\"},\n    \"2002-01-04\":                [{\n        \"k\": {\"type\": \"integer\", \"value\": \"12\"}\n    }],\n    \"2001-02-11\": {\n        \"a\": {\n            \"2001-02-12\": {\"type\": \"integer\", \"value\": \"9\"}\n        }\n    },\n    \"2002-01-02\": {\n        \"k\": {\"type\": \"integer\", \"value\": \"10\"},\n        \"2024-01-03\": {\n            \"k\": {\"type\": \"integer\", \"value\": \"11\"}\n        }\n    },\n    \"a\": {\n        \"2001-02-08\": {\"type\": \"integer\", \"value\": \"7\"},\n        \"2001-02-09\": {\n            \"2001-02-10\": {\"type\": \"integer\", \"value\": \"8\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/key/numeric-01.toml",
      src: b"1     = true\x0a",
      want: "{\n    \"1\": {\"type\": \"bool\", \"value\": \"true\"}\n}\n",
    },
    {
      name: "valid/key/numeric-02.toml",
      src: b"1.2   = true\x0a",
      want: "{\n    \"1\": {\n        \"2\": {\"type\": \"bool\", \"value\": \"true\"}\n    }\n}\n",
    },
    {
      name: "valid/key/numeric-03.toml",
      src: b"0123  = true\x0a",
      want: "{\n    \"0123\": {\"type\": \"bool\", \"value\": \"true\"}\n}\n",
    },
    {
      name: "valid/key/numeric-04.toml",
      src: b"01.23 = true\x0a",
      want: "{\n    \"01\": {\n        \"23\": {\"type\": \"bool\", \"value\": \"true\"}\n    }\n}\n",
    },
    {
      name: "valid/key/numeric-05.toml",
      src: b"23.01 = true\x0a",
      want: "{\n    \"23\": {\n        \"01\": {\"type\": \"bool\", \"value\": \"true\"}\n    }\n}\n",
    },
    {
      name: "valid/key/numeric-06.toml",
      src: b"-1    = true\x0a",
      want: "{\n    \"-1\": {\"type\": \"bool\", \"value\": \"true\"}\n}\n",
    },
    {
      name: "valid/key/numeric-07.toml",
      src: b"-01   = true\x0a",
      want: "{\n    \"-01\": {\"type\": \"bool\", \"value\": \"true\"}\n}\n",
    },
  ]
}

///|
fn accepted_11_05() -> Array[Accepted] {
  [
    {
      name: "valid/key/numeric-08.toml",
      src: b"1  = 'one'\x0a01 = 'zero one'\x0a",
      want: "{\n    \"01\": {\"type\": \"string\", \"value\": \"zero one\"},\n    \"1\":  {\"type\": \"string\", \"value\": \"one\"}\n}\n",
    },
    {
      name: "valid/key/quoted-dots.toml",
      src: b"plain = 1\x0a\"with.dot\" = 2\x0a\x0a[plain_table]\x0aplain = 3\x0a\"with.dot\" = 4\x0a\x0a[table.withdot]\x0aplain = 5\x0a\"key.with.dots\" = 6\x0a\"escaped\\u002edot\" = 7\x0a",
      want: "{\n    \"plain\":    {\"type\": \"integer\", \"value\": \"1\"},\n    \"with.dot\": {\"type\": \"integer\", \"value\": \"2\"},\n    \"plain_table\": {\n        \"plain\":    {\"type\": \"integer\", \"value\": \"3\"},\n        \"with.dot\": {\"type\": \"integer\", \"value\": \"4\"}\n    },\n    \"table\": {\n        \"withdot\": {\n            \"escaped.dot\":   {\"type\": \"integer\", \"value\": \"7\"},\n            \"key.with.dots\": {\"type\": \"integer\", \"value\": \"6\"},\n            \"plain\":         {\"type\": \"integer\", \"value\": \"5\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/key/quoted-unicode.toml",
      src: b"\x0a\"\\u0000\" = \"null\"\x0a'\\u0000' = \"different key\"\x0a\"\\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\" = \"escaped key\"\x0a\x0a\"~ \xc2\x80 \xc3\xbf \xed\x9f\xbf \xee\x80\x80 \xef\xbf\xbf \xf0\x90\x80\x80 \xf4\x8f\xbf\xbf\" = \"basic key\"\x0a'l ~ \xc2\x80 \xc3\xbf \xed\x9f\xbf \xee\x80\x80 \xef\xbf\xbf \xf0\x90\x80\x80 \xf4\x8f\xbf\xbf' = \"literal key\"\x0a",
      want: "{\n    \"\\u0000\":               {\"type\": \"string\", \"value\": \"null\"},\n    \"\\b \\f A \u{7f} \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\": {\"type\": \"string\", \"value\": \"escaped key\"},\n    \"\\\\u0000\":              {\"type\": \"string\", \"value\": \"different key\"},\n    \"l ~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\":      {\"type\": \"string\", \"value\": \"literal key\"},\n    \"~ \u{80} \u{ff} \u{d7ff} \u{e000} \u{ffff} \u{10000} \u{10ffff}\":        {\"type\": \"string\", \"value\": \"basic key\"}\n}\n",
    },
    {
      name: "valid/key/space.toml",
      src: b"# Keep whitespace inside quotes keys at all positions.\x0a\"a b\"   = 1\x0a\" c d \" = 2\x0a\"  much \x09\x09  whitespace  \x09\\n  \\r\\n  \" = 3\x0a\x0a[ \" tbl \" ]\x0a\"\\ttab\\ttab\\t\" = \"tab\"\x0a",
      want: "{\n    \"  much \\t\\t  whitespace  \\t\\n  \\r\\n  \": {\"type\": \"integer\", \"value\": \"3\"},\n    \" c d \":                             {\"type\": \"integer\", \"value\": \"2\"},\n    \"a b\":                               {\"type\": \"integer\", \"value\": \"1\"},\n    \" tbl \": {\n        \"\\ttab\\ttab\\t\": {\"type\": \"string\", \"value\": \"tab\"}\n    }\n}\n",
    },
    {
      name: "valid/key/special-chars.toml",
      src: b"\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\" = 1\x0a",
      want: "{\n    \"=~!@$^\\u0026*()_+-`1234567890[]|/?\\u003e\\u003c.,;:'=\": {\"type\": \"integer\", \"value\": \"1\"}\n}\n",
    },
    {
      name: "valid/key/special-word.toml",
      src: b"false = false\x0atrue = 1\x0ainf = 100000000\x0anan = \"ceci n'est pas un nombre\"\x0a\x0a",
      want: "{\n    \"false\": {\"type\": \"bool\", \"value\": \"false\"},\n    \"inf\":   {\"type\": \"integer\", \"value\": \"100000000\"},\n    \"nan\":   {\"type\": \"string\", \"value\": \"ceci n'est pas un nombre\"},\n    \"true\":  {\"type\": \"integer\", \"value\": \"1\"}\n}\n",
    },
    {
      name: "valid/key/start.toml",
      src: b"# Table and keys can start with any character; there is no requirement for it to\x0a# start with a letter.\x0a\x0a[-key]\x0a-key = 1\x0a\x0a[_key]\x0a_key = 2\x0a\x0a[1key]\x0a1key = 3\x0a\x0a[-]\x0a- = 4\x0a\x0a[_]\x0a_ = 5\x0a\x0a[1] \x0a1 = 6\x0a\x0a[---] \x0a--- = 7\x0a\x0a[___]\x0a___ = 8\x0a\x0a[111]\x0a111 = 9\x0a\x0a[inline]\x0a--- = {--- = 10, ___ = 11, 111 = 12}\x0a",
      want: "{\n    \"-\": {\n        \"-\": {\"type\": \"integer\", \"value\": \"4\"}\n    },\n    \"---\": {\n        \"---\": {\"type\": \"integer\", \"value\": \"7\"}\n    },\n    \"-key\": {\n        \"-key\": {\"type\": \"integer\", \"value\": \"1\"}\n    },\n    \"1\": {\n        \"1\": {\"type\": \"integer\", \"value\": \"6\"}\n    },\n    \"111\": {\n        \"111\": {\"type\": \"integer\", \"value\": \"9\"}\n    },\n    \"1key\": {\n        \"1key\": {\"type\": \"integer\", \"value\": \"3\"}\n    },\n    \"_\": {\n        \"_\": {\"type\": \"integer\", \"value\": \"5\"}\n    },\n    \"___\": {\n        \"___\": {\"type\": \"integer\", \"value\": \"8\"}\n    },\n    \"_key\": {\n        \"_key\": {\"type\": \"integer\", \"value\": \"2\"}\n    },\n    \"inline\": {\n        \"---\": {\n            \"---\": {\"type\": \"integer\", \"value\": \"10\"},\n            \"111\": {\"type\": \"integer\", \"value\": \"12\"},\n            \"___\": {\"type\": \"integer\", \"value\": \"11\"}\n        }\n    }\n}\n",
    },
    {
      name: "valid/key/zero.toml",
      src: b"0=0\x0a",
      want: "{\n    \"0\": {\"type\": \"integer\", \"value\": \"0\"}\n}\n",
    },
    {
      name: "valid/multibyte.toml",
