name = "moonbitstack/moontoml"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moontoml"

license = "Apache-2.0"

keywords = [ "toml", "config", "parser", "moonbit" ]

description = "moontoml — TOML 1.0.0 for MoonBit. Reads and writes the format MoonBit's own moon.mod and moon.pkg are written in, into the same `Json` tree every other reader in this family produces: tables and arrays of tables, dotted keys, the four string forms, the four date-time forms, and integers in four bases."

import {
  "moonbitstack/moondate@0.1.0",
}
