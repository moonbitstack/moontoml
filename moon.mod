name = "moonbitstack/moontoml"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moontoml"

license = "Apache-2.0"

keywords = [ "toml", "config", "parser", "moonbit" ]

description = "moontoml — TOML 1.0.0 for MoonBit. Read a document into a `Json` tree, write it back, and get a line and a column when it refuses: tables and arrays of tables, dotted keys, four string forms, four date-time forms, and integers in four bases."

import {
  "moonbitstack/moondate@0.1.0",
}
