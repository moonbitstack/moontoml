name = "moonbitstack/moontoml"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moontoml"

license = "Apache-2.0"

keywords = [
  "toml",
  "toml-1.0",
  "config",
  "configuration",
  "parser",
  "serializer",
  "moonbit",
]

description = "TOML for MoonBit, 1.0.0 and earlier."

import {
  "moonbitstack/moondate@0.1.0",
}

source = "src"
