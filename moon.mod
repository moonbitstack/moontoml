name = "moonbitstack/moontoml"

version = "0.1.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moontoml"

license = "Apache-2.0"

keywords = [
  "toml",
  "toml-1.0",
  "toml-test",
  "toml-parser",
  "toml-encoder",
  "config",
  "configuration",
  "parser",
  "serializer",
  "decoder",
  "encoder",
  "datetime",
  "rfc3339",
  "json",
  "moonbit",
]

description = "TOML for MoonBit, 1.0.0 and earlier."

import {
  "moonbitstack/moondate@0.1.5",
}

source = "src"
