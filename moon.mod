name = "moonbitstack/moontoml"

version = "0.1.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/moontoml"

license = "Apache-2.0"

keywords = [
  "toml",
  "toml-0.4",
  "toml-0.5",
  "toml-1.0",
  "toml-1.1",
  "toml-test",
  "toml-parser",
  "toml-encoder",
  "toml-reader",
  "toml-writer",
  "config",
  "configuration",
  "manifest",
  "moon.mod",
  "parser",
  "serializer",
  "decoder",
  "encoder",
  "datetime",
  "rfc3339",
  "json",
  "moonjson",
  "javascript",
  "wasm",
  "browser",
  "interop",
  "edition",
  "dialect",
  "fidelity",
  "round-trip",
  "roundtrip",
  "lossless",
  "in-place",
  "edit",
  "document",
  "comment",
  "moonbit",
]

description = "TOML for MoonBit, at the edition the file was written in, with a reading that keeps the document as it was."

import {
  "moonbitstack/moondate@0.1.7",
  "moonbitstack/moonjson@0.5.0",
}

source = "src"
